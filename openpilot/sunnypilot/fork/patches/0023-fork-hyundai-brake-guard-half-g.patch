+class TestUrgentBrakeAuthority(unittest.TestCase):
+  """2026-11-03 (owner ruling: the guard may be 0.5 g). Route 190 saturated at the 20 LSB standard tier (2.28 m/s^2) while
+  a lead closed to 2.9 m, and the driver's own brake hit -3.2 m/s^2 in the same second. A genuine hard-stop ask now spends
+  the raised WIRE gate (46 LSB ~= 0.5 g) instead of the tier cap; every other ask keeps its tier exactly."""
+
+  def test_hard_ask_spends_the_raised_gate(self):
+    gate = 46
+    self.assertEqual(gate, fl.effective_max_dec(fl.PERSONALITY_STANDARD, -3.0, gate))
+    self.assertEqual(gate, fl.effective_max_dec(fl.PERSONALITY_RELAXED, -2.5, gate))
+
+  def test_normal_ask_keeps_its_tier(self):
+    gate = 46
+    for p in (fl.PERSONALITY_RELAXED, fl.PERSONALITY_STANDARD, fl.PERSONALITY_AGGRESSIVE):
+      self.assertEqual(fl.personality_max_dec(p), fl.effective_max_dec(p, -1.0, gate))
+      self.assertEqual(fl.personality_max_dec(p), fl.effective_max_dec(p, -2.2, gate))
+
+  def test_no_gate_means_the_deployed_ceiling(self):
+    # the old-law / feel instance passes no gate, so it stays on the deployed mapping ceiling byte-for-byte
+    self.assertEqual(fl.personality_max_dec(fl.PERSONALITY_STANDARD),
+                     fl.effective_max_dec(fl.PERSONALITY_STANDARD, -3.0, 0))
+    self.assertEqual(fl.FCA11_MEAS_CEIL_LSB, 30)
+    self.assertEqual(30, fl.dec_cmd_from_accel_measured(-6.0, None))
+    self.assertEqual(46, fl.dec_cmd_from_accel_measured(-6.0, None, 46))
+
+  def test_the_law_ceiling_is_not_the_wire_gate(self):
+    # the tuned hold and the aggressive tier stay at the deployed 30 no matter how high the wire gate goes
+    self.assertEqual(30, fl.personality_max_dec(fl.PERSONALITY_AGGRESSIVE))
+    self.assertEqual(30, fl.fca11_standstill_hold_lsb())
+    self.assertLessEqual(max(fl.PERSONALITY_MAX_DEC.values()), fl.FCA11_MEAS_CEIL_LSB)
