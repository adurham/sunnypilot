+  def test_0039_accepts_the_logged_route_195_hold_frame(self):
+    """0039: the panda accepts the pair frame the car NOW produces, at the route-195 hold inputs, proven from the wire.
+
+    The camera's own 0x38D on bus 2 at t=9851.314 was `00 00 08 00 d0 7f fe 94`; the production builder turns it into the
+    host frame the car sent 8 ms later, `19 1e 18 00 d8 7f fe d7` (Prefill 1, DecCmd 30, Warn 3, CmdAct 1, DecCmdAct 0,
+    HBA 0, StopReq 0) - reproduced here byte for byte. Adding the pair at that same level changes ONLY CF_VSM_HBACmd,
+    FCA_StopReq and the checksum. The harness encodes exactly those field values, so `_hold_cmd(30)` IS that frame; the
+    inputs are the logged ones (standstill, fastest wheel 0.00-0.31 km/h = raw 0, TCS13 FCA_ACK = StandStill = 1)."""
+    from opendbc.sunnypilot.car.hyundai import fca11_long as fl
+    cam = bytes.fromhex("00000800d07ffe94")
+    logged = bytes.fromhex("191e1800d87ffed7")
+    base = fl.Fca11MirrorFrame(dec_cmd=30, prefill=True, warn=3, cmd_act=True, dec_cmd_act=False)
+    self.assertEqual(logged, fl.build_fca11_frame(cam, 11, base), "the builder must reproduce the logged host frame")
+    held = fl.build_fca11_frame(cam, 11, fl.Fca11MirrorFrame(dec_cmd=30, prefill=True, warn=3, cmd_act=True,
+                                                            dec_cmd_act=False, stop_hold=True))
+    self.assertEqual((1, 1), (fl._get_bits(held, 1, 2), fl._get_bits(held, 21, 1)))
+    # only the two pair fields (and the checksum that covers them) move
+    self.assertEqual(logged[0] & ~0x06, held[0] & ~0x06)     # byte 0 bits 1-2 = CF_VSM_HBACmd
+    self.assertEqual(logged[2] & ~0x20, held[2] & ~0x20)     # byte 2 bit 5  = FCA_StopReq
+    self.assertEqual(logged[1], held[1])
+    self.assertEqual(logged[3:7], held[3:7])
+    self.assertNotEqual(logged[7], held[7])
+    for raw in (0, 1, self.STOP_RAW):                        # logged fastest wheel 0.00-0.31 km/h, bound 1.0
+      with self.subTest(raw=raw):
+        self._hold_ready(raw, dec=30)
+        self.assertTrue(self._tx(self._hold_cmd(30)), f"raw {raw}: the logged hold frame carrying the pair is accepted")
+
