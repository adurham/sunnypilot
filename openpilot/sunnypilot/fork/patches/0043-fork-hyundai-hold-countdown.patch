+  def test_k_a_disengage_at_the_expiry_boundary_is_byte_identical_to_the_base(self):
+    """P1(b): the same hold, disengaged one armed sent frame before expiry (5999), exactly at it (6000) and one after
+    (6001), plus a 130 s hold that is never disengaged. Every one must hash to what the BASE tree produces for that
+    exact stream: the observer cannot change a byte, not even on the frame it expires on."""
+    for n in (5999, 6000, 6001):
+      sha, sent, armed, nag = _disengage_stream(n_armed=n)
+      self.assertEqual(n, armed, "activity: exactly n armed sent frames before the disengage")
+      self.assertEqual(BASE_DISENGAGE_SHA[("armed", n)], sha, f"disengage at armed sent frame {n}")
+      # the nag is non-decreasing up to the disengage and drops to 0 the frame the counter resets, unless the latch
+      # caught it - so max() is the state the disengage arrived in
+      self.assertEqual(EXPIRED if n >= EXPIRE_F else FINAL, max(nag),
+                       f"the latch state when the disengage lands {n} armed frames in")
+    # the brief words this as "sent frame N": same measurement, and it lands 4 armed frames short of the boundary
+    # because the onset ramp is below the arming level. The wire is identical either way; the latch is not.
+    sha, sent, armed, nag = _disengage_stream(n_sent=6000)
+    self.assertEqual(6000, sent)
+    self.assertEqual(5996, armed)
+    self.assertEqual(BASE_DISENGAGE_SHA[("sent", 6000)], sha, "disengage at the 6000th SENT frame")
+    self.assertEqual(FINAL, max(nag), "4 armed frames short of expiry is not expiry")
+    self.assertEqual(NONE, nag[-1], "and with no latch the counter reset takes the banner away")
+    # and a plain 130 s hold that is never disengaged
+    sha, sent, armed, nag = _disengage_stream(None, hold_frames=13000)
+    self.assertEqual(6500, sent)
+    self.assertEqual(BASE_130S_SHA, sha, "a 130 s hold")
+    self.assertEqual(EXPIRED, nag[-1])
+def _disengage_stream(n_armed=None, n_sent=None, hold_frames=12600):
+  """Feed a steady standstill hold and drop longActive on the frame the boundary is reached.
+
+  `n_armed` counts SENT frames at or above the arming level (what the countdown counts); `n_sent` counts every SENT
+  0x38D (what P1(b)'s wording says). They are NOT the same number: the first 4 sent frames of an episode are the onset
+  ramp and sit below 20 LSB, so "sent frame 6000" is "armed frame 5996" - which is why BOTH are measured here.
+  Returns (sha256 of frame+bytes over every sent 0x38D, sent count, armed count, nag per controller frame).
+  """
+  brake = fl.Fca11LongBrake(structs.CarParams(), _cp_sp())
+  brake._dyn_log = None
+  brake._mark_log = None
+  h = hashlib.sha256()
+  sent = armed = 0
+  nag = []
+  for f in range(hold_frames):
+    long_active = not ((n_armed is not None and armed >= n_armed) or (n_sent is not None and sent >= n_sent))
+    cs = _CS(v_ego=0.0, cam=(0, CAM), standstill=True, a_ego=-1.5)
+    cs.fca11_wheel_max_kph = 0.0
+    for s in brake.update(_cc(-2.0, engaged=long_active, long_active=long_active), cs, f):
+      if s.address == fl.FCA11_ADDR:
+        h.update(f.to_bytes(4, "little") + bytes(s.dat))
+        sent += 1
+        armed += fl._get_bits(s.dat, 8, 8) >= ARM_LSB
+    nag.append(int(getattr(brake, "hold_nag", NONE)))
+  return h.hexdigest(), sent, armed, nag
