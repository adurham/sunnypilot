+# *** The GOLDEN, taken from the tree WITHOUT the countdown (the 0040 base + 0042). ***
+# The two streams above run in THIS tree, so a side effect _hold_nag_step had on the law would appear in both runs and
+# cancel out. These pins cannot: they were taken by running the SAME script through the base class (/tmp/CD-base =
+# aa9bff6f + patches 0001..0040 + 0042, no countdown at all). The whole stream - frame number + every 0x38D byte - is
+# byte-for-byte what that tree puts on the wire.
+# RE-PIN RULE: if the law changes, re-run this file's `_scenario_streams()` against the base tree and take its hashes;
+# do NOT re-pin from this tree (that is how a wire regression becomes invisible).
+# WHICH writes it catches (measured, not argued): the hold CEILING (FCA11_STANDSTILL_HOLD_LSB written down to 20), the
+# actuation GATE (self._actuating = False) and the panda's rate REFERENCE (self._dec_last_sent = 0) each change the
+# sha256 or the sent count and fail this test.
+GOLDEN_BASE_SHA256 = "133319d868752ebf419a9a1e181590b74ca44e8828c74f1cf4643dce490db0de"
+GOLDEN_BASE_SENT_FRAMES = 35753
+# 722 s: approach 5 s; hold 130 s; brake tap; re-engage; hold 200 s; gas; N; re-engage; hold 190 s; disengage; hold
+# 190 s; launch. 72 200 controller frames at 100 Hz.
+GOLDEN_SCRIPT = (
+  (5, {"v": 3.0, "ss": False, "ask": -1.5}),
+  (130, {}),
+  (0.3, {"brake": True}),
+  (0.1, {"eng": False, "long": False}),
+  (200, {}),
+  (0.5, {"gas": True}),
+  (2, {"gear": structs.CarState.GearShifter.neutral}),
+  (0.1, {"eng": False, "long": False}),
+  (190, {}),
+  (1, {"long": False, "eng": False}),
+  (190, {}),
+  (3, {"v": 2.0, "ss": False, "ask": 0.5}),
+)
+
+
+def _scenario_streams():
+  """Run GOLDEN_SCRIPT through the REAL class.
+
+  Returns (sha256, sent_frames, armed_frames, nag-per-frame, [(frame, level)] of every sent frame).
+  """
+  brake = fl.Fca11LongBrake(structs.CarParams(), _cp_sp())
+  brake._dyn_log = None
+  brake._mark_log = None
+  h = hashlib.sha256()
+  sent = armed = 0
+  frame = 0
+  nag, levels = [], []
+  for dur, kw in GOLDEN_SCRIPT:
+    for _ in range(int(dur * 100)):
+      v = kw.get("v", 0.0)
+      cs = _CS(v_ego=v, cam=(0, CAM), standstill=kw.get("ss", True),
+               a_ego=-1.5 if kw.get("ask", -2.0) < 0 else 0.3,
+               brake=kw.get("brake", False), gear=kw.get("gear", structs.CarState.GearShifter.drive))
+      cs.out.gasPressed = kw.get("gas", False)
+      cs.fca11_wheel_max_kph = v * 3.6
+      cc = _cc(kw.get("ask", -2.0))
+      cc.longActive = kw.get("long", True)
+      cc.enabled = kw.get("eng", True)
+      for s in brake.update(cc, cs, frame):
+        if s.address == fl.FCA11_ADDR:
+          h.update(frame.to_bytes(4, "little") + bytes(s.dat))
+          sent += 1
+          lv = fl._get_bits(s.dat, 8, 8)
+          armed += lv >= ARM_LSB
+          levels.append((frame, lv))
+      nag.append(int(getattr(brake, "hold_nag", NONE)))
+      frame += 1
+  return h.hexdigest(), sent, armed, nag, levels
+
