+    self.assertEqual(4500, _nag_at(rec, LOUD), "loud must land on the 4500th")
+    self.assertEqual(5500, _nag_at(rec, FINAL), "final must land on the 5500th")
+    self.assertEqual(6000, _nag_at(rec, EXPIRED), "expiry must land on the 6000th")
