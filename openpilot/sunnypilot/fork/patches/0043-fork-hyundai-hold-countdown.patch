@@ -0,0 +1,810 @@
+"""
+0043-CD: the standstill HOLD COUNTDOWN v2 - 60 s silent, 90 s audible, 110 s immediate, 120 s RELEASE.
+
+Owner's spec (2026-11-06): "move it to 2 mins / a silent banner after 1 min / an audio alert after 1:30 seconds /
+release the brakes after 2 mins". This REPLACES 0041-N, whose rule was the opposite ("the hold is never released").
+
+Four tiers, counted in SENT 0x38D frames at 50 Hz (controller 100 Hz / FCA11_SEND_EVERY == 2):
+  1 soft     3000 frames =  60 s   silent banner
+  2 loud     4500 frames =  90 s   audible and CONTINUOUS (no repeat/pulse logic any more)
+  3 final    5500 frames = 110 s   warningImmediate
+  4 EXPIRED  6000 frames = 120 s   a STICKY latch: at 2:00 longitudinal control disengages and the brakes release;
+                                   lateral (MADS) stays engaged by design. The law stops sending and the ESC is
+                                   released (the panda hands FCA11 back to the camera's idle frame at +90 ms,
+                                   compiled libsafety - lane-X3/proof_release_compiled.py). The latch survives the
+                                   counter reset that the disengage itself causes and clears ONLY on the driver's
+                                   brake press.
+The clock starts at a DEAD STOP - all four wheels at rest - not when the braking began (CD3, owner definition), and
+EVERY proof that says "deployed" runs the CAR'S CarParamsSP (continuous brake law ON, see _cp_sp_deployed), not the
+Brake-only arm; both arms are in the matrix.
+The law is UNTOUCHED: this block is a pure observer of the sent level and never writes it. The tests below prove the
+wire is byte-identical to the tree without the countdown, including through a disengage at 5999/6000/6001 sent frames.
+
+Every stream test drives the REAL controller (Fca11LongBrake.update) with a CarState double, exactly as the stop-hold
+lane's tests do, and reads the state the superproject publishes (CarStateSP.holdNag) plus what actually went out.
+Every behavioural test asserts an ACTIVITY bound first: a leg that sends no frames would pass any assertion about
+what it sends.
+"""
+import hashlib
+import unittest
+
+from opendbc.car import structs
+from opendbc.sunnypilot.car.hyundai import fca11_long as fl
+from opendbc.sunnypilot.car.hyundai.tests.test_fca11_long import _CS, _cc, _real_camera_frame
+
+CAM = _real_camera_frame(alive=3)
+# read defensively, so a run against a tree WITHOUT the countdown fails on its claims (the nag never runs), not on an
+# AttributeError - the same rule lane V was reviewed against.
+NONE = int(getattr(fl, "FCA11_HOLD_NAG_NONE", 0))
+SOFT = int(getattr(fl, "FCA11_HOLD_NAG_SOFT", 1))
+LOUD = int(getattr(fl, "FCA11_HOLD_NAG_LOUD", 2))
+FINAL = int(getattr(fl, "FCA11_HOLD_NAG_FINAL", 3))
+EXPIRED = int(getattr(fl, "FCA11_HOLD_NAG_EXPIRED", 4))
+ARM_LSB = int(getattr(fl, "FCA11_HOLD_NAG_MIN_LSB", 20))
+SOFT_F = int(getattr(fl, "FCA11_HOLD_NAG_SOFT_FRAMES", 3000))
+LOUD_F = int(getattr(fl, "FCA11_HOLD_NAG_LOUD_FRAMES", 4500))
+FINAL_F = int(getattr(fl, "FCA11_HOLD_NAG_FINAL_FRAMES", 5500))
+EXPIRE_F = int(getattr(fl, "FCA11_HOLD_NAG_EXPIRE_FRAMES", 6000))
+
+
+def _cp_sp(fca11=True):
+  cp_sp = structs.CarParamsSP()
+  cp_sp.fca11Brake = fca11
+  cp_sp.enableGasInterceptor = True
+  return cp_sp
+
+
+# *** THE CAR'S DEPLOYED CONFIGURATION (device snapshot 2026-11-06 12:00) ***
+# Every CP_SP field the car has ON at runtime, by its STRUCT name (opendbc/car/structs.py CarParamsSP), not by the
+# params key that writes it:
+#   HyundaiFca11Brake=1          -> fca11Brake
+#   HyundaiFca11AffineGain=1     -> fca11AffineGain
+#   HyundaiFca11DynamicBrakes=1  -> fca11DynamicBrakes
+#   HyundaiPedalDeliveryLaw=1    -> pedalDeliveryLaw
+#   HyundaiGasRiseLag=1          -> gasRiseLag
+#   HyundaiGasInterceptor=1      -> enableGasInterceptor
+#   HyundaiFca11Shadow=0         -> fca11Shadow          (OFF)
+#   HyundaiFca11StopHoldClutch=0 -> fca11StopHoldClutch  (OFF)
+# The countdown proofs used to be built with `_cp_sp()` (Brake + interceptor only), which leaves the CONTINUOUS brake
+# law OFF - so they measured a configuration the car does not run. Everything that says "deployed" below uses this.
+DEPLOYED_ON = ("fca11Brake", "fca11AffineGain", "fca11DynamicBrakes", "pedalDeliveryLaw", "gasRiseLag",
+               "enableGasInterceptor")
+DEPLOYED_OFF = ("fca11Shadow", "fca11StopHoldClutch")
+
+
+def _cp_sp_deployed():
+  """CarParamsSP exactly as the car builds it (see DEPLOYED_ON / DEPLOYED_OFF)."""
+  cp_sp = structs.CarParamsSP()
+  for name in DEPLOYED_ON:
+    setattr(cp_sp, name, True)
+  for name in DEPLOYED_OFF:
+    setattr(cp_sp, name, False)
+  return cp_sp
+
+
+def _assert_deployed(brake):
+  """Fail LOUDLY if the harness is not really running the car's configuration.
+
+  The instance attributes are the law's own resolution of CP_SP (Fca11LongBrake.__init__), so this catches a
+  mis-built struct rather than re-asserting the fields back at itself. Measured on this tree:
+    cont_law      True   <- FCA11_CONT_ENABLED and shape_track (the continuous law the car runs)
+    shape_track   True   <- affine_gain AND fca11DynamicBrakes AND not shadow/core
+    affine_gain   True   <- fca11AffineGain AND fca11Brake AND not shadow
+    feel          False  <- the 0049 feel layer is OLD-LAW-instance only (`and not self.affine_gain`)
+    dynamic_brakes False <- scoped to the feel path, so it is False on the shaped/continuous instance even with
+                            CP_SP.fca11DynamicBrakes True. The release RAMP is a feel-path feature and therefore
+                            does NOT run on the car; the passive close frame (_release_pending) does.
+  """
+  assert brake.enabled, "deployed config must actuate (fca11Brake AND the gas interceptor)"
+  assert brake.affine_gain, "deployed config must resolve affine_gain"
+  assert brake.shape_track, "deployed config must resolve shape_track (affine AND fca11DynamicBrakes AND not shadow)"
+  assert brake.cont_law, "deployed config must resolve cont_law - the continuous brake law the car runs"
+  assert not brake.shadow, "the car runs Shadow OFF"
+  assert not brake.feel, "affine_gain supersedes the feel layer - feel must be False on the deployed instance"
+  assert not brake.dynamic_brakes, "the release ramp is feel-path only: dynamic_brakes is False on the shaped instance"
+  assert not brake.standstill_hold, "standstill_hold is feel-path only"
+
+
+def _assert_brake_only(brake):
+  """The OTHER arm of the matrix: Brake + interceptor only, i.e. the pre-0043 continuous law OFF."""
+  assert brake.enabled and brake.feel
+  assert not brake.affine_gain and not brake.shape_track and not brake.cont_law
+
+
+def _hold(brake, n, ask=-2.0, v=0.0, standstill=True, brake_pressed=False, gear=None, start=0, record=None,
+          engaged=True, long_active=True, wheel_max_kph=None, gas=False):
+  """Run n controller frames of a steady standstill hold. Returns [(frame, sends, hold_nag)] for every frame.
+
+  `ask` is the planner ask; at a standstill a firm one (-2.0) holds the 30 LSB ceiling the wire allows, which is the
+  regime the countdown is about. `wheel_max_kph` is the FASTEST of the four wheels (CD3: the strict dead-stop gate);
+  None means "the car is doing v", i.e. v * 3.6, so a rolling leg and a dead stop are independent knobs.
+  The camera is fresh on every frame.
+  """
+  if record is None:
+    record = []
+  for f in range(start, start + n):
+    cs = _CS(v_ego=v, cam=(0, CAM), standstill=standstill, a_ego=-1.5 if ask < 0 else 0.3,
+             brake=brake_pressed, gear=gear or structs.CarState.GearShifter.drive)
+    cs.out.gasPressed = gas
+    cs.fca11_wheel_max_kph = v * 3.6 if wheel_max_kph is None else wheel_max_kph
+    sends = brake.update(_cc(ask, engaged=engaged, long_active=long_active), cs, f)
+    record.append((f, sends, int(getattr(brake, "hold_nag", NONE))))
+  return record
+
+
+def _wire(record):
+  """[(frame, bytes)] of every 0x38D actually sent, in order."""
+  out = []
+  for f, sends, _nag in record:
+    out.extend((f, bytes(s.dat)) for s in sends if s.address == fl.FCA11_ADDR)
+  return out
+
+
+def _levels(record):
+  return [(f, fl._get_bits(dat, 8, 8)) for f, dat in _wire(record)]
+
+
+def _armed(record):
+  """Every SENT frame at or above the arming level - the frames the countdown counts."""
+  return [(f, lv) for f, lv in _levels(record) if lv >= ARM_LSB]
+
+
+def _hold_until_armed(brake, n_armed, start=0, **kw):
+  """Feed one controller frame at a time until exactly n_armed armed SENT frames have gone out.
+
+  The first sent frames of an episode are below the arming level (the onset ramp), so "119.98 s" is NOT "5999 armed
+  frames" - the boundary tests have to be built on the armed count itself.
+  """
+  rec = []
+  f = start
+  while len(_armed(rec)) < n_armed:
+    rec.extend(_hold(brake, 1, start=f, **kw))
+    f += 1
+    if f - start > 40 * n_armed:
+      raise AssertionError("the hold never reached the armed count")
+  return rec, f
+
+
+def _first_nag(record, want):
+  for f, _sends, nag in record:
+    if nag == want:
+      return f
+  return None
+
+
+def _nag_at(record, want):
+  """The count of SENT-armed frames at the moment the state first became ``want``."""
+  armed = _armed(record)
+  f_want = _first_nag(record, want)
+  if f_want is None:
+    return None
+  return sum(1 for f, _lv in armed if f <= f_want)
+
+
+class TestTierShape(unittest.TestCase):
+  """The pure four-tier escalation, in SENT frames."""
+
+  def test_named_constants(self):
+    self.assertEqual(3000, fl.FCA11_HOLD_NAG_SOFT_FRAMES)
+    self.assertEqual(4500, fl.FCA11_HOLD_NAG_LOUD_FRAMES)
+    self.assertEqual(5500, fl.FCA11_HOLD_NAG_FINAL_FRAMES)
+    self.assertEqual(6000, fl.FCA11_HOLD_NAG_EXPIRE_FRAMES)
+    self.assertEqual(20, fl.FCA11_HOLD_NAG_MIN_LSB)
+    self.assertEqual((0, 1, 2, 3, 4), (NONE, SOFT, LOUD, FINAL, EXPIRED))
+    # the 0041-N repeat/pulse machinery is GONE: an asserted alert loops in soundd, so there is nothing to re-chime
+    for gone in ("FCA11_HOLD_NAG_REPEAT_S", "FCA11_HOLD_NAG_LOUD_PULSE_S",
+                 "FCA11_HOLD_NAG_SOFT_S", "FCA11_HOLD_NAG_LOUD_S"):
+      self.assertFalse(hasattr(fl, gone), f"{gone} must be gone in v2")
+
+  def test_tier_edges_by_value(self):
+    """Both sides of every edge, by value: the counter is compared as FRAMES, never as seconds."""
+    # LITERALS on purpose (60/90/110 s at 50 sent Hz): an expectation derived from the constant would move with a
+    # mutation of that constant and prove nothing. These are the owner's times, not a restatement of the code.
+    self.assertEqual(NONE, fl.hold_nag_level(0))
+    self.assertEqual(NONE, fl.hold_nag_level(3000 - 1))
+    self.assertEqual(SOFT, fl.hold_nag_level(3000))
+    self.assertEqual(SOFT, fl.hold_nag_level(4500 - 1))
+    self.assertEqual(LOUD, fl.hold_nag_level(4500))
+    self.assertEqual(LOUD, fl.hold_nag_level(5500 - 1))
+    self.assertEqual(FINAL, fl.hold_nag_level(5500))
+    self.assertEqual(NONE, fl.hold_nag_level(-5), "never negative")
+    # and the module constants ARE those numbers (a shift here is a behaviour change, caught by test_b as well)
+    self.assertEqual((3000, 4500, 5500, 6000),
+                     (fl.FCA11_HOLD_NAG_SOFT_FRAMES, fl.FCA11_HOLD_NAG_LOUD_FRAMES,
+                      fl.FCA11_HOLD_NAG_FINAL_FRAMES, fl.FCA11_HOLD_NAG_EXPIRE_FRAMES))
+
+  def test_expired_is_not_a_tier(self):
+    """hold_nag_level stops at 3: EXPIRED is a latch that has to survive the counter reset, so it cannot be a value of
+    the pure function (a counter-derived 4 would drop back to 0 on the disengage frame - the bug this pins)."""
+    self.assertEqual(FINAL, fl.hold_nag_level(EXPIRE_F - 1))
+    self.assertEqual(FINAL, fl.hold_nag_level(EXPIRE_F))
+    self.assertEqual(FINAL, fl.hold_nag_level(10 * EXPIRE_F))
