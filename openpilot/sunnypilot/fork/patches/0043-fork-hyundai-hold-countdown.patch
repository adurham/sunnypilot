+  ("armed", 6000): "ecbe08bed6cd9d808e8c40d13e10452b99c0d2b72743bd484dd1e76d2961bd69",
+  ("armed", 6001): "7de985a07e05dd90d19f05de52ba8758c02dcb75f322f04eacc50e1d4c3eeae4",
+  ("sent", 6000): "b098e3e8a5fb5adbd90c63108b7b9baca91f55583685583874b9438d33332ef1",
+}
+BASE_130S_SHA = "a3efc997d1302589fc4ff20c14616aa19513ae22733ac12164c4f9167329304c"
