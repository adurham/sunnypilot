+    self.assertEqual(GOLDEN_BASE_SHA256, sha, "the countdown must not change ONE byte of the base stream")
+    # the stream IS a real hold (>= 20 LSB on 99 % of sent frames), so the identity above means something
+    self.assertGreaterEqual(armed, int(0.99 * sent))
+    # and the countdown really ran across that stream: every tier was reached in the first 130 s hold, and each tier
+    # landed on its own ARMED SENT FRAME count (3000 / 4500 / 5500 / 6000), not on wall time
+    armed_frames = [f for f, lv in levels if lv >= ARM_LSB]
+    self.assertGreaterEqual(len(armed_frames), EXPIRE_F, "activity: the first hold must reach expiry")
+    for want, threshold in ((SOFT, SOFT_F), (LOUD, LOUD_F), (FINAL, FINAL_F), (EXPIRED, EXPIRE_F)):
+      f_want = nag.index(want)
+      self.assertEqual(threshold, sum(1 for f in armed_frames if f <= f_want),
+                       f"tier {want} must land on armed sent frame {threshold}")
+    ends, stop = [], 0
+    for dur, _kw in GOLDEN_SCRIPT:
+      stop += int(dur * 100)
+      ends.append(nag[stop - 1])
+    # brake / gas / N / disengage: the two holds both expire, so 4 survives every phase end after them - the brake
+    # tap at 135 s is the ONE thing that drops it back to 0, and nothing after it (gas, N, disengage, moving) clears it
+    self.assertEqual([0, EXPIRED, NONE, NONE, EXPIRED, EXPIRED, EXPIRED, EXPIRED, EXPIRED, EXPIRED, EXPIRED, EXPIRED],
