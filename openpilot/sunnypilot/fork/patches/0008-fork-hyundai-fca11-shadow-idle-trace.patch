+  def frame_idle(self, rec: dict) -> None:
+    """0054: one IDLE frame record, written OUTSIDE the shadow window - the availability trace.
+
+    ``fca11_long._shadow_record`` calls this at 2 Hz (plus one on every change of its diagnostic state tuple) while the
+    feature is ARMED but longitudinal is NOT active, and always while ``fca11_unavailable`` holds. Route 16a: the
+    windowed trace above stops the moment nothing is braking, so a 170 s "FCA11 Braking Unavailable" window (raised
+    14:36:13, cleared 14:39:04) fell entirely between two records and could not be read from the log at all. The record
+    is the SAME frame record (same builder, same field names, same schema) plus two keys the caller adds: ``idle``
+    (True) and ``diag`` (the OLD-LAW availability tuple - the flags that actually raise the alert, which the frame
+    record's V3 mirrors can never show).
+
+    The 1 s pre-context ring is DROPPED here: everything in it is OLDER than this record, so flushing it later (on a
+    window opening) would both break the log's time order and blow the 2 Hz byte budget. Flushed immediately - at 2 Hz
+    that is one small append, and a drive that ends abruptly still keeps its last 0.5 s.
+    """
+    if not self.enabled or self.truncated:
+      return
+    self._pre = []
+    self.write(dict(rec, k="f"))
+    self.flush()
+
   def epilogue(self, rec: dict) -> None:
     self.write(dict(rec, k="ep"))
     self.flush()
