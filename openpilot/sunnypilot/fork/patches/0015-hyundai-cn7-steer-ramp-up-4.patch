@@ -56,6 +56,13 @@ class CarControllerParams:
     else:
       self.STEER_MAX = 384
 
+    # CN7 Elantra N (non-SCC port): faster torque ramp-up only, ceiling unchanged. Logged EPS output (MDPS12 CR_Mdps_OutTq)
