+                                        hyundai_alt_limits ? HYUNDAI_STEERING_LIMITS_ALT :
+                                        cn7_ramp ? HYUNDAI_STEERING_LIMITS_CN7_RAMP : HYUNDAI_STEERING_LIMITS;
 
     if (steer_torque_cmd_checks(desired_torque, steer_req, limits)) {
