+FCA11_CONT_CEIL_LSB = FCA11_TRACK_CEIL_MAX_LSB   # 30: the one ceiling (panda gate 46 untouched)
+FCA11_CONT_HOLD_FLOOR_LSB = FCA11_CRAWL_MIN_LSB  # 7: creep floor in the stop band (an OPEN clutch - measured)
