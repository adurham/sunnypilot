   CF_VSM_Prefill (0,1), CF_VSM_HBACmd (1,2), CF_VSM_Warn (3,2), CF_VSM_BeltCmd (5,3),
@@ -79,6 +86,21 @@ FCA11_ONSET_BYPASS_ACCEL = -1.2
 FCA11_MIN_ON_S = FCA11_MIN_ON_FRAMES / 100.0
 FCA11_ONSET_HOLD_S = FCA11_ONSET_HOLD_FRAMES / 100.0
 
+# *** G7 (N1): passive release frame + the panda's actuation-budget mirror ***
+# The panda's FCA11-long tx hook (safety/modes/hyundai.h:146-149, 939-975) caps a CONTINUOUS actuation
+# episode at 2.5 s, then refuses new actuation for a 3 s cooldown of passive frames. An episode ends
+# ONLY on an accepted passive 0x38D frame from the host (L970-973) or by budget expiry (L948-951).
+# Before G7 the car layer sent NOTHING when not braking, so act_active stayed latched across separate
+# brakes and the budget kept running - on the road only ~45-57 % of the intended brake time actuated
+# (round-5 N1). G7 mirrors the same 2.5 s / 3 s state machine here so `braking` (and hence the gas
+# hard-zero and the alerts) matches what the panda will really accept: the car layer deliberately
+# ends an episode at the budget edge (with its passive frame) rather than keep commanding frames the
+# panda refuses inside the cooldown.
+# Controller frames are 100 Hz, so the budget/cooldown are counted in frames; the panda times both
+# from the same microsecond clock, and the +-1-frame quantisation is sub-20 ms either side.
+FCA11_BUDGET_FRAMES = 250    # 2.5 s at 100 Hz: == HYUNDAI_FCA11_LONG_MAX_ACT_US (safety/modes/hyundai.h:148)
+FCA11_COOLDOWN_FRAMES = 300  # 3.0 s at 100 Hz: == HYUNDAI_FCA11_LONG_COOLDOWN_US (safety/modes/hyundai.h:149)
+
 # planner-side speed floor (km/h). 3 km/h above the panda's 9 km/h backstop so the panda floor is
 # never the thing that ends a brake; below this the planner requests coast-only (the PID limits in
 # the interface are floored at 0) and this module never sends.
@@ -239,7 +261,13 @@ class Fca11LongBrake:
 
   Inert (``update`` returns [] and ``braking`` is False) unless ``CP_SP.fca11Brake`` is set. All
   panda-facing state comes through ``CS`` attributes only (CarState writes them), so the class
-  works identically against the real card loop and a test double."""
+  works identically against the real card loop and a test double.
+
+  ``braking`` is True only while an ACTUATING frame is being sent; on the true -> false edge the
+  class emits exactly one PASSIVE mirror frame (the camera's idle shape: all brake fields 0, Warn 0)
+  to close the panda's FCA11-long episode. The panda's 2.5 s budget / 3 s cooldown is mirrored here so
+  the class stops commanding at the budget edge instead of being silently refused in the cooldown.
+  """
 
   def __init__(self, CP: structs.CarParams, CP_SP: structs.CarParamsSP, dbc_names: dict | None = None):
     self.CP = CP
@@ -254,6 +282,11 @@ class Fca11LongBrake:
     # ---- G5 anti-flap state ----
     self._ask_frames = 0               # consecutive frames of (window-open AND accel <= ONSET) since last reset
     self._on_frames = 0                # consecutive frames we have wanted to brake (the current episode age)
+    # ---- G7 panda actuation-budget mirror + passive release edge ----
+    self._budget_start = 0             # controller frame at which the current ACTUATION episode opened
+    self._in_budget = False            # inside a continuous actuation episode (== the panda's act_active)
+    self._budget_end = -1              # frame at which the episode ended (cooldown runs from here)
+    self._release_pending = False      # a passive frame is owed (the braking true -> false edge)
 
   # ---- window ----
 
@@ -293,6 +326,24 @@ class Fca11LongBrake:
     closing = bool(getattr(CS, "fca11_lead_closing", False))
     return closing and FCA11_BRAKE_MIN_KPH < v_kph <= FCA11_BRAKE_MIN_KPH + FCA11_ALERT_MARGIN_KPH
 
+  def _passive_frame(self, CS, frame: int) -> list[CanData]:
+    """One PASSIVE mirror frame (the camera's own idle shape: DecCmd 0, Prefill 0, Warn 0, CmdAct 0,
+    DecCmdAct 0, fresh alive + CRC, every other byte the camera's).
+
+    This is the clean release / hand-back frame the panda accepts while ``controls_allowed`` AND
+    ``heartbeat_engaged`` (safety/modes/hyundai.h:903-931, 963-973); it is what ENDS an actuation
+    episode and starts the cooldown clock. Only sent on the FCA11_SEND_EVERY slot, same 50 Hz stream
+    as the actuating frames, and only when a fresh camera frame is in hand (never a hardcoded frame -
+    the mirror is always sourced from the latest bus-2 0x38D).
+    """
+    cam = getattr(CS, "fca11_cam_frame", None)
+    if cam is None or len(cam[1]) != 8 or frame % FCA11_SEND_EVERY != 0:
+      return []
+    t_cam, dat = cam
+    cam_alive = (dat[4] >> 3) & 0xF  # CR_FCA_Alive is 35|4 = byte4 bits 3-6
+    m = Fca11MirrorFrame(dec_cmd=0, prefill=False, warn=0, cmd_act=False, dec_cmd_act=False)
+    return [CanData(FCA11_ADDR, build_fca11_frame(dat, (cam_alive + 1) & 0xF, m), 0)]
+
   def update(self, CC: structs.CarControl, CS, frame: int, personality=PERSONALITY_STANDARD) -> list[CanData]:
     sends: list[CanData] = []
     if not self.enabled:
@@ -301,6 +352,10 @@ class Fca11LongBrake:
       # G5: an inert controller must not carry debounce/min-on state into a later re-enable.
       self._ask_frames = 0
       self._on_frames = 0
+      # G7: likewise no budget/cooldown state survives a disable (a re-arm is a clean panda episode too).
+      self._in_budget = False
+      self._budget_end = -1
+      self._release_pending = False
       return sends
 
     # resume model: any disengage -> re-engage transition clears a cut latch (the pause/resume
@@ -327,6 +382,11 @@ class Fca11LongBrake:
       # G5: disengaging long clears the debounce/min-on state; the next engagement starts clean.
       self._ask_frames = 0
       self._on_frames = 0
+      # G7: the panda's episode state resets with the arm, and longActive off means we are not sending;
+      # clear the budget/cooldown mirror and owe no passive frame.
+      self._in_budget = False
+      self._budget_end = -1
+      self._release_pending = False
       return sends
 
     accel = float(CC.actuators.accel)
@@ -349,6 +409,27 @@ class Fca11LongBrake:
                    (accel <= FCA11_BRAKE_RELEASE_ACCEL or self._on_frames < FCA11_MIN_ON_FRAMES))
     want_brake = bool(onset or holding)
 
+    # ---- G7 panda actuation-budget mirror -------------------------------------------------------
+    # Mirror of safety/modes/hyundai.h:944-961. `self._in_budget` == the panda's act_active.
+    #   * while in an episode, a CONTINUOUS actuation runs at most FCA11_BUDGET_FRAMES (2.5 s); at the
+    #     budget edge the panda ENDS the episode and REFUSES that frame -> we must stop commanding
+    #     (not merely be cut): end here, release below with the passive frame, start the cooldown.
+    #   * after an episode ends (budget or release), a NEW actuation is refused for
+    #     FCA11_COOLDOWN_FRAMES (3 s) of passive frames -> we must not re-command inside it.
+    # A frame we would command inside the cooldown is a frame the panda refuses; refusing it here is
+    # what keeps `braking`/gas-zero/alerts honest. Safety-only paths (`ok` false, longActive off,
+    # camera owns, CUT) are evaluated BEFORE this and are untouched by the budget mirror.
+    cooldown_active = (not self._in_budget) and self._budget_end >= 0 and (frame - self._budget_end) <= FCA11_COOLDOWN_FRAMES
+    if want_brake and self._in_budget and (frame - self._budget_start) > FCA11_BUDGET_FRAMES:
+      # budget spent: the panda would refuse this very frame and end the episode here
+      self._in_budget = False
+      self._budget_end = frame
+      want_brake = False
+    elif want_brake and cooldown_active:
+      # still inside the passive cooldown: a new actuation is refused by the panda, so do not ask
+      want_brake = False
+    # ---------------------------------------------------------------------------------------------
+
     if want_brake:
       # Release hysteresis: inside the band [-0.50, -0.30] the command is floored at the ONSET value so
       # the ESC never sees a 0 mid-episode (a 0 would be an immediate release, defeating the hysteresis).
@@ -368,12 +449,30 @@ class Fca11LongBrake:
       self.braking = True
       self._sent_this_episode = True
       self._dec_last_sent = dec_cmd
+      if not self._in_budget:
+        # first accepted actuation of a new episode: open the budget clock (the panda starts it on the
+        # first accepted actuating frame, hyundai.h:967-969).
+        self._in_budget = True
+        self._budget_start = frame
+        self._budget_end = -1
     else:
-      # not braking: the camera's own FCA11 keeps flowing (panda's dynamic block opens within one
-      # camera period of our last frame).
+      # not braking: the camera's own FCA11 keeps flowing, and G7 sends ONE passive frame to close the
+      # panda's episode (see _passive_frame). The camera path alone does NOT pass the panda TX hook, so
+      # without this the panda's act_active stays latched across brakes (round-5 N1).
+      was_braking = self.braking
       self.braking = False
       self._dec_last_sent = 0
       self._sent_this_episode = False
+      if was_braking:
+        # braking true -> false edge: end the panda episode, start the cooldown clock, owe a passive frame
+        if self._in_budget:
+          self._in_budget = False
+        self._budget_end = frame
+        self._release_pending = True
+      if self._release_pending:
+        sends += self._passive_frame(CS, frame)
+        if sends:  # emitted (frame % SEND_EVERY == 0); if [] we retry next frame
+          self._release_pending = False
 
     # episode age AFTER this frame's decision (consumed by `holding` on the next frame).
     self._on_frames = self._on_frames + 1 if want_brake else 0
