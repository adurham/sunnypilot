+  def test_two_episodes_without_a_passive_frame_stay_one_episode(self):
+    """G7/N1 pin: two planner brakes with NO passive 0x38D in between (exactly what the car layer did
+    before G7 - it sent NOTHING when not braking, and the camera's own frames do not pass this TX hook)
+    are ONE panda episode. act_active (hyundai.h:970-973) stays latched while actuation simply pauses,
+    so the 2.5 s budget keeps running from the FIRST brake: the second brake is silently refused at the
+    budget edge and again through the 3 s cooldown. Sending a passive frame (test below) is the fix."""
+    self._rearm()  # fixes the clock so the budget arithmetic is absolute
+    self._open_window()
+    # episode 1: brake for 1.0 s, then STOP sending (no passive frame) - exactly the pre-G7 car layer
+    self.assertTrue(self._tx(self._brake_cmd(1)))
+    t1 = 1000000 + int(1.0e6)
+    self.safety.set_timer(t1)
+    self._open_window()
+    self.assertTrue(self._tx(self._brake_cmd(1)))
+    # the actuation pauses here (no host frame at all for 0.4 s): act_active stays latched
+    # episode 2: brake again. Still the SAME episode, so the clock is 1.0 s + 0.4 s + 1.0 s = 2.4 s < 2.5 s
+    t2 = t1 + int(0.4e6)
+    self.safety.set_timer(t2)
+    self._open_window()
+    self.assertTrue(self._tx(self._brake_cmd(1)))     # accepted: still inside the same, longer episode
+    # but the budget runs from the FIRST accepted actuation: 1.0 + 0.4 + 1.2 = 2.6 s > 2.5 s -> refused
+    self.safety.set_timer(t1 + int(1.7e6))
+    self._open_window()
+    self.assertFalse(self._tx(self._brake_cmd(1)))    # the SECOND brake is silently cut at the budget edge
+    # ... and inside the cooldown every new actuation is refused
+    self.safety.set_timer(t1 + int(1.7e6) + int(1.0e6))
+    self._open_window()
+    self.assertFalse(self._tx(self._brake_cmd(1)))
+    # a passive host frame ends the episode; only then does the cooldown clock start and the budget re-arm
+    self.assertTrue(self._tx(self._fca11()))
+    self.safety.set_timer(t1 + int(1.7e6) + int(1.0e6) + HYUNDAI_FCA11_LONG_COOLDOWN_US + 2)
+    self._open_window()
+    self.assertTrue(self._tx(self._brake_cmd(1)))
+
+  def test_passive_frame_between_episodes_rearms_the_budget(self):
+    """G7 fix, panda side: the SAME two brakes, but with the passive 0x38D the car layer now sends on
+    each release. The passive frame ends episode 1 and starts the cooldown; episode 2 opens after it,
+    so each brake gets its own full 2.5 s budget (this is the G7 pairing with fca11_long.py)."""
+    self._rearm()
+    self._open_window()
+    self.assertTrue(self._tx(self._brake_cmd(1)))                 # episode 1
+    t1 = 1000000 + int(1.0e6)
+    self.safety.set_timer(t1)
+    self.assertTrue(self._tx(self._fca11()))                     # G7: passive release on the edge
+    # the cooldown runs from the passive frame; a NEW actuation just past it opens episode 2 fresh
+    t2 = t1 + HYUNDAI_FCA11_LONG_COOLDOWN_US + 2
+    self.safety.set_timer(t2)
+    self._open_window()
+    self.assertTrue(self._tx(self._brake_cmd(1)))                # episode 2, its own budget
+    # the full 2.5 s of episode 2 is now allowed (the budget restarted, it did not continue)
+    self.safety.set_timer(t2 + HYUNDAI_FCA11_LONG_MAX_ACT_US - 1)
+    self._open_window()
+    self.assertTrue(self._tx(self._brake_cmd(1)))
+    self.safety.set_timer(t2 + HYUNDAI_FCA11_LONG_MAX_ACT_US + 1)
+    self._open_window()
+    self.assertFalse(self._tx(self._brake_cmd(1)))
+
   # *** latched cut ***
 
   def _assert_cut_latched(self):
