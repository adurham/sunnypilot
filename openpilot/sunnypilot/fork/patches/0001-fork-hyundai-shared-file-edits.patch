+  ok = ok && ((pkt->data[3] >> 4) == (((cluster->data[3] >> 4) + 1U) & 0xFU));
+  ok = ok && ((pkt->data[0] & 0xC0U) == (cluster->data[0] & 0xC0U)) && (pkt->data[1] == cluster->data[1]) &&
