+        tx = self._self_tx()
+        self.assertEqual(1, len(tx), c)
+        d = tx[0]["dat"]
+        self.assertEqual((c + 1) & 0xF, d[3] >> 4)
+        self.assertEqual((bin(d[0] & 0xF).count("1") + bin(d[3] >> 4).count("1")) & 1, (d[0] >> 5) & 1, c)
