+    self.assertEqual(HYUNDAI_LKAS_PARK_RATE_UP, _c_define(HYUNDAI_H, "HYUNDAI_LKAS_PARK_RATE_UP"))
+    self.assertEqual(HYUNDAI_LKAS_PARK_RATE_DOWN, _c_define(HYUNDAI_H, "HYUNDAI_LKAS_PARK_RATE_DOWN"))
