+  def _interceptor_gas_cmd_raw(self, addr, raw):
+    dat = bytearray(6)
+    dat[0], dat[1] = (raw >> 8) & 0xFF, raw & 0xFF
+    dat[2], dat[3] = (raw >> 9) & 0xFF, (raw >> 1) & 0xFF
+    dat[4] = 0x80
+    return libsafety_py.make_CANPacket(addr, 0, bytes(dat))
