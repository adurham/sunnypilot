+              [(-0.9, vs, self.SET_KPH)] * 40 + [(0.2, vs, self.SET_KPH)] * 60)
+    deployed = self._run_gas(self._ci(delivery=False), series)
+    for mode in (0, 2, 3, 6, 7):
+      assert self._run_gas(self._ci(delivery=True), series, mode=mode) == deployed, f"mode {mode} must keep the deployed law"
+    # and NORMAL really is the new law (otherwise the gate would be silently doing nothing)
+    assert self._run_gas(self._ci(delivery=True), series, mode=1) != deployed
