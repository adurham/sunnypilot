+    self._rearm_guarded(HyundaiSafetyFlagsSP.PEDAL_FAULT_GRACE)
+    self._open_window()
+    for dt in (10000, 20000, 30000):
+      self._fault_at(dt)
+      self.assertTrue(self._tx(self._brake_cmd(1)), dt)   # every observation is still inside the window
+    self._fault_at(HYUNDAI_FCA11_PEDAL_FAULT_GRACE_US + 10000, refresh=True)
+    self.assertFalse(self._tx(self._brake_cmd(1)), "a persisting fault must latch once past the window")
+
+  def test_guard_frames_requires_n_consecutive_faults(self):
+    self._rearm(self._sp_with(HyundaiSafetyFlagsSP.PEDAL_FAULT_FRAMES))
