+
+  def _sp_with(self, *bits) -> int:
+    sp = self._pedal_sp()
+    for b in bits:
+      sp |= b
+    return sp
+
+  def _rearm_guarded(self, *bits):
+    # the grace window is anchored to hyundai_init's OWN timer stamp, and _rearm sets the timer AFTER set_safety_hooks -
+    # so stamp the arm clock FIRST, then re-arm (the guard tests are the only ones that read the init time).
+    self.safety.set_timer(1000000)
+    self._rearm(self._sp_with(*bits))
+
+  def _tx_refused(self) -> bool:
+    return not self._tx(self._brake_cmd(1))
+
+  def _fault_at(self, dt_us: int, state: int = 3, refresh: bool = False):
+    """One pedal fault frame dt_us after the arm's hyundai_init. The frame's OWN stamp is what the grace guard reads.
+    refresh=True re-feeds the OTHER window inputs at the same instant (they go stale after ~100 ms, and a stale window
+    refuses an actuating frame for a reason that has nothing to do with the cut - the 0x701 itself is NOT re-fed clean,
+    which would reset the consecutive run)."""
+    self.safety.set_timer(1000000 + dt_us)
+    if refresh:
+      self.assertTrue(self._rx(self._user_brake_msg(False)))
+      self.assertTrue(self._rx(self._user_gas_msg(0)))
+      self.assertTrue(self._rx(self._gear_msg(5)))
+      self.assertTrue(self._rx(self._wheel_msg(self.IN_WINDOW_RAW)))
+    self.assertTrue(self._rx(self._interceptor_user_gas(0, state=state)))
+
+  def test_guard_off_is_the_deployed_rule(self):
+    # both bits clear (the shipped default): a SINGLE fault frame latches, whatever its timing after the arm
+    self._rearm()
+    self._open_window()
+    self._fault_at(12000)
+    self.assertTrue(self._tx_refused())
+
+  def test_guard_grace_suppresses_the_startup_frame(self):
+    # the 1a0 timeline exactly: ONE SCE frame 19 ms after hyundai_init must NOT latch under the grace window ...
+    self._rearm_guarded(HyundaiSafetyFlagsSP.PEDAL_FAULT_GRACE)
+    self._open_window()
+    self._fault_at(19000)
+    self.assertTrue(self._tx(self._brake_cmd(1)), "the 1a0 startup frame must not latch under the grace guard")
+    # ... and a fault observed OUTSIDE the window still latches (fresh window, so the refusal IS the cut)
+    self._fault_at(HYUNDAI_FCA11_PEDAL_FAULT_GRACE_US + 100000, refresh=True)
+    self.assertFalse(self._tx(self._brake_cmd(1)))
+    self.assertTrue(self._tx(self._fca11()))                     # the passive carrier stream still flows
+    self._fault_at(HYUNDAI_FCA11_PEDAL_FAULT_GRACE_US + 200000, refresh=True)
+    self.assertFalse(self._tx(self._brake_cmd(1)), "still cut until the next init")
