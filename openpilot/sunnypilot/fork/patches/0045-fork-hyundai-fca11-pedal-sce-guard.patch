+// *** PROPOSAL (0045, OWNER DECISION): the two pedal-fault guards ***
+// The deployed rule latches hyundai_fca11_long_cut on ANY 0x701 frame whose STATE is a fault (not 0/4/5), and only
+// hyundai_init clears it. That is fail-closed, but it has a STARTUP RACE: the pedal emits an SCE burst at EVERY power
+// transition, and a single frame landing just after hyundai_init (route 1a0, 2026-11-09: 7.191973 s, 0-19 ms after the
+// switch) latched the cut for the whole ignition - 187/187 actuating frames refused at 666.33-670.07 s, no FCA11
+// braking for 20.7 min. Both guards are OPT-IN (safetyParam bits 4096/8192, written from the car layer's
+// HyundaiFca11PedalGuard param) and OFF by default, so an unmodified build is byte-for-byte the deployed rule.
+//   (a) GRACE: a fault OBSERVED within HYUNDAI_FCA11_PEDAL_FAULT_GRACE_US of hyundai_init does not latch. A fault that
+//       PERSISTS past the window latches on its first observation outside it - still fail-closed.
+//   (b) FRAMES: latch only after HYUNDAI_FCA11_PEDAL_FAULT_FRAMES CONSECUTIVE fault frames; any accepted 0x701 frame
+//       resets the run. 1 = the deployed rule (any single frame).
+// MUST equal HYUNDAI_FCA11_PEDAL_FAULT_GRACE_US / _FAULT_FRAMES in opendbc/sunnypilot/car/hyundai/values.py.
+#define HYUNDAI_FCA11_PEDAL_FAULT_GRACE_US 500000U   // option (a): 0.5 s = ~25x the observed 12-19 ms startup race
+#define HYUNDAI_FCA11_PEDAL_FAULT_FRAMES 3U          // option (b): 3 frames @ 100 Hz = ~30 ms of continuous fault
+
+// 0045: the last pedal-fault OBSERVATION (its frame time, not the evaluation time - a grace-suppressed frame must never
+// latch later on a stale flag) and its CONSECUTIVE run, both reset by any accepted 0x701 frame. hyundai_init_ts is
+// stamped by every hyundai_init (the panda's ignition / re-arm edge) in hyundai_fca11_long_reset().
+static uint32_t hyundai_init_ts;
+static uint32_t hyundai_interceptor_pedal_fault_ts;
+static uint32_t hyundai_interceptor_pedal_fault_run;
+
+// 0045: may the CURRENT pedal-fault observation latch the cut? Both guards are vetoes, so with their safetyParam bits
+// clear this is exactly the deployed `fault -> cut` rule. A persisting fault keeps sending frames, so guard (a) only
+// DELAYS the latch to the first observation outside the window, and guard (b) to the Nth consecutive frame.
+static bool hyundai_fca11_pedal_fault_cut_ok(void) {
+  if (!hyundai_interceptor_pedal_fault) {
+    return false;
+  }
+  if (hyundai_fca11_pedal_grace &&
+      (safety_get_ts_elapsed(hyundai_interceptor_pedal_fault_ts, hyundai_init_ts) < HYUNDAI_FCA11_PEDAL_FAULT_GRACE_US)) {
+    return false;
+  }
+  if (hyundai_fca11_pedal_frames_guard && (hyundai_interceptor_pedal_fault_run < HYUNDAI_FCA11_PEDAL_FAULT_FRAMES)) {
+    return false;
+  }
+  return true;
+}
