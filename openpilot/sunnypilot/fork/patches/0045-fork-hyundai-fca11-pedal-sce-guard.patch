+             fl.FCA11_PEDAL_GUARD_FRAMES)
+    self.assertTrue(b._pedal_cut)
+
+  def test_frames_does_not_latch_on_a_short_run(self):
+    b = self._brake(fl.HYUNDAI_FCA11_PEDAL_GUARD_FRAMES)
+    b.update(self._cc(), _CS(state=3, fault_seen=True, fault_run=1, cam=_cam()), 0)
+    b.update(self._cc(), _CS(state=0, fault_run=0, cam=_cam()), 1)
