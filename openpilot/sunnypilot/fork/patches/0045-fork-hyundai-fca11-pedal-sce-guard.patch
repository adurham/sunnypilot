+class TestFca11PedalSceGuard(unittest.TestCase):
+  """0045 (PROPOSAL, OWNER DECISION): the car-layer half of the two pedal-fault guards.
+
+  Route 1a0 (2026-11-09) proved the deployed rule's startup race: ONE pedal STATE=3 (SCE) frame 12-19 ms after
+  hyundai_init latched the panda's hyundai_fca11_long_cut and this mirror for the whole ignition (187/187 actuating
+  frames refused; no FCA11 braking for 20.7 min). Each guard is one CP_SP.fca11PedalGuard bit (1 = grace window after
+  the arm, 2 = N consecutive fault frames); 0 - the shipped value - keeps the deployed single-frame rule that
+  TestFca11PedalCutLatch pins. With a guard ON the latch reads the TRAILING run (CS.interceptor_fault_run) so a
+  suppressed frame cannot latch later on a stale window; a persisting fault still latches (fail-closed preserved).
+  """
+
+  def _cc(self):
+    cc = structs.CarControl()
+    cc.enabled = True
+    cc.longActive = True
+    cc.actuators.accel = -1.0
+    return cc
+
+  def _brake(self, guard=0):
+    cp_sp = structs.CarParamsSP()
+    cp_sp.fca11Brake = True
+    cp_sp.enableGasInterceptor = True
+    cp_sp.fca11PedalGuard = guard
+    return fl.Fca11LongBrake(structs.CarParams(), cp_sp)
+
+  def test_guard_is_read_once_and_masked(self):
+    self.assertEqual(0, self._brake(0).pedal_guard)
+    self.assertEqual(1, self._brake(1).pedal_guard)
+    self.assertEqual(3, self._brake(3).pedal_guard)
+    self.assertEqual(1, self._brake(0b10001).pedal_guard, "unknown bits are masked off, never a behaviour")
+
+  def test_guard_zero_keeps_the_deployed_single_frame_latch(self):
+    b = self._brake(0)
+    b.update(self._cc(), _CS(state=3, fault_seen=True, fault_run=1, cam=_cam()), 0)
+    self.assertTrue(b._pedal_cut)
+    self.assertTrue(b.fca11_unavailable)
+    self.assertEqual(fl.FCA11_CUT_SOURCE_PEDAL, b.fca11_cut_source)
+
+  def test_grace_suppresses_the_startup_frame(self):
+    b = self._brake(fl.HYUNDAI_FCA11_PEDAL_GUARD_GRACE)
+    b.update(self._cc(), _CS(state=3, fault_seen=True, fault_run=1, cam=_cam()), 0)
+    self.assertFalse(b._pedal_cut, "the startup SCE frame must not latch under the grace guard")
+    self.assertFalse(b.fca11_unavailable)
+    # the pedal recovers: a clean trailing state must NOT resurrect the suppressed frame later
+    sent = [x for f in range(1, 60) for x in b.update(self._cc(), _CS(state=0, fault_run=0, cam=_cam()), f)
+            if fl._get_bits(x.dat, 8, 8) > 0]
+    self.assertTrue(sent)
+    self.assertFalse(b._pedal_cut)
+    # a fault observed AFTER the window latches (fail-closed preserved)
+    b.update(self._cc(), _CS(state=3, fault_seen=True, fault_run=1, cam=_cam()), 60)
+    self.assertTrue(b._pedal_cut)
+
+  def test_grace_still_fails_closed_on_a_stuck_pedal(self):
+    b = self._brake(fl.HYUNDAI_FCA11_PEDAL_GUARD_GRACE)
+    latched_at = None
+    for f in range(0, 60):
+      b.update(self._cc(), _CS(state=3, fault_seen=True, fault_run=f + 1, cam=_cam()), f)
+      if b._pedal_cut and latched_at is None:
