+class TestClosingDemand(unittest.TestCase):
+  """2026-11-03 (route 191): over 1,568 engaged plan frames the planner's aTarget sat below -2.0 m/s^2 on EIGHT frames and
+  never below -3.0, while the driver's own pedal hit -2.4..-3.2 in the same drive. Raising the law's ceiling does nothing
+  when the ask never arrives, so the law now computes its own closing-lead demand: a = -c^2 / (2 * (d - gap))."""
+
+  def _law(self, dynamic=True):
+    b = object.__new__(fl.Fca11LongBrake)
+    b.dynamic_brakes = dynamic
+    return b
+
+  def _cs(self, d, vr):
+    class CS:
+      pass
+    cs = CS()
+    cs.fca11_lead_drel_m = d
+    cs.fca11_lead_vrel_mps = vr
+    return cs
+
+  def test_no_lead_or_not_closing_leaves_the_ask_alone(self):
+    law = self._law()
+    self.assertEqual(-1.0, law._closing_demand(self._cs(None, None), -1.0))
+    self.assertEqual(-1.0, law._closing_demand(self._cs(20.0, 2.0), -1.0), "lead pulling away")
+    self.assertEqual(-1.0, law._closing_demand(self._cs(20.0, -0.5), -1.0), "following, not closing")
+
+  def test_physics_of_the_demand(self):
+    law = self._law()
+    # 5 m/s closing at 20 m with a 4 m gap -> 25 / (2 * 16) = 0.78 m/s^2
+    self.assertAlmostEqual(-0.781, law._closing_demand(self._cs(20.0, -5.0), -0.2), places=2)
+    # 10 m/s closing at 20 m -> 100 / 32 = 3.13
+    self.assertAlmostEqual(-3.125, law._closing_demand(self._cs(20.0, -10.0), -0.2), places=2)
+    # it never softens a harder planner ask
+    self.assertEqual(-3.5, law._closing_demand(self._cs(20.0, -5.0), -3.5))
+
+  def test_it_is_capped_by_the_wire_gate(self):
+    law = self._law()
+    self.assertEqual(-fl.FCA11_AEB_MAX_MSS2, law._closing_demand(self._cs(8.0, -30.0), 0.0))
+
+  def test_only_the_dynamic_instance_computes_it(self):
+    self.assertEqual(-0.2, self._law(False)._closing_demand(self._cs(20.0, -10.0), -0.2))
+
+  def test_beyond_range_is_not_a_stopping_problem(self):
+    law = self._law()
+    self.assertEqual(-0.2, law._closing_demand(self._cs(45.0, -10.0), -0.2))
