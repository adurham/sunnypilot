+# ---------------------------------------------------------------------------------------------- no send
+class TestShadowNeverSends:
+  def test_module_returns_nothing_and_is_non_actuating(self):
+    _, CP, CP_SP = _cp(brake="1", shaping="1", shadow="1")
+    b = fl.Fca11LongBrake(CP, CP_SP)
+    res = _drive(b, _script())
+    assert all(s == [] for _, s, _ in res)
+    assert all(o.non_actuating for _, _, o in res)
+    assert any(o.wouldbe_sends for _, _, o in res)      # the would-be frames exist ... but were never returned
+    assert not b.braking and not b._cal_active
+    assert not (b.supervise_stop or b.stop_complete or b.brake_now)
+
+  @pytest.mark.parametrize("brake,shaping", [("1", "1"), ("1", "0"), ("0", "0"), (None, "1")])
+  def test_controller_stream_equals_brake_off_and_has_zero_0x38d(self, brake, shaping):
+    """REAL CarController path (create_gas_command): Shadow stream == Brake-OFF stream byte-for-byte; zero 0x38D."""
+    CIc, CP, CP_SP = _cp(brake=brake, shaping=shaping, shadow="1")
+    CIo, CPo, CP_SPo = _cp(brake="0", shadow=None)
+    ci_s, ci_o = CIc(CP, CP_SP), CIo(CPo, CP_SPo)
+    cs_s, cs_o = _CS(), _CS()
+    n38d = 0
+    for k, a, v, warn in _script():
+      for cs in (cs_s, cs_o):
+        cs.out.vEgo = v
+        cs.fca11_cam_frame = (k * 10_000_000, _cam(alive=(k // 2) % 16, warn=warn))
+      s1 = ci_s.CC.create_gas_command(_cc(a), cs_s, k, k * 10_000_000)
+      s0 = ci_o.CC.create_gas_command(_cc(a), cs_o, k, k * 10_000_000)
+      n38d += sum(1 for m in s1 if m[0] == 0x38D)
+      assert [(m[0], bytes(m[1]), m[2]) for m in s1] == [(m[0], bytes(m[1]), m[2]) for m in s0], k
+      assert ci_s.CC.gas == ci_o.CC.gas
+    assert n38d == 0
+    assert ci_s.CC.shadow_dropped == 0
+    assert ci_s.CC.fca11_brake.shadow_out.non_actuating
+
+  def test_seam_drops_any_0x38d_that_reaches_it(self, monkeypatch):
+    """D2 assertion: even if the module DID return a frame in Shadow, the gas_interceptor seam never forwards it."""
+    CIc, CP, CP_SP = _cp(brake="1", shadow="1")
+    ci = CIc(CP, CP_SP)
+    leak = fl.CanData(0x38D, _cam(), 0)
+    monkeypatch.setattr(ci.CC.fca11_brake, "update", lambda *a, **k: [leak])
+    cs = _CS()
+    cs.fca11_cam_frame = (0, _cam())
+    sends = ci.CC.create_gas_command(_cc(-1.5), cs, 0, 0)
+    assert not any(m[0] == 0x38D for m in sends)
+    assert ci.CC.shadow_dropped == 1
+
