+      alert_bits_wouldbe=int(v3.supervise_stop) | (int(v3.stop_complete) << 1) | (int(v3.brake_now) << 2),
+    )
+    if self.shadow_log is not None:
+      window = bool(braking or bool(self._shadow_dep.braking) or cam_req or
+                    (CC.longActive and accel_law <= FCA11_BRAKE_RELEASE_ACCEL))
+      self.shadow_log.frame(rec, window)
+    if ep is not None and not braking:
+      ep.update(frame_end=int(frame), t_wall_end=time.time(), duration_s=round((frame - ep["frame_start"]) * 0.01, 2),
+                v_end_mps=v, end_reason=(why or "release"), shaped_min=(ep["shaped_min"] or 0))
+      ep = {k: (round(x, 4) if isinstance(x, float) else x) for k, x in ep.items()}
+      if self.shadow_log is not None:
+        self.shadow_log.epilogue(ep)
+      self._sh_ep = None
+
   def update(self, CC: structs.CarControl, CS, frame: int, personality=PERSONALITY_STANDARD) -> list[CanData]:
+    if self.shadow:
+      # 0045 SHADOW: compute + log only. NEVER returns a frame (the would-be frames live on shadow_out.wouldbe_sends).
+      return self._shadow_update(CC, CS, frame, personality)
     sends: list[CanData] = []
     if not self.enabled:
       self.braking = False
diff --git a/opendbc/sunnypilot/car/hyundai/fca11_shadow_log.py b/opendbc/sunnypilot/car/hyundai/fca11_shadow_log.py
new file mode 100644
index 00000000..9096f0de
--- /dev/null
+++ b/opendbc/sunnypilot/car/hyundai/fca11_shadow_log.py
@@ -0,0 +1,167 @@
+"""
+Copyright (c) 2021-, Haibin Wen, sunnypilot, and a number of other contributors.
+
+This file is part of sunnypilot and is licensed under the MIT License.
+See the LICENSE.md file in the root directory for more details.
+
+0045: FCA11 SHADOW (log-only) writer -- ``fca11-shadow.jsonl``.
+
+WHY THIS EXISTS
+The FCA11 final settlement BLOCKED actuating the v3 shaping law (it trades braking authority for smoothness on a
+safety tail the sim plant cannot confirm or clear) and AUTHORIZED a SHADOW deploy: the build computes the law's
+would-be output every frame and LOGS it; it NEVER sends. This module is the log. It records PRIMITIVES only (asks,
+speeds, would-be levels of each law, camera request, latch/state flags, lead) so any authority-floor design can be
+derived OFFLINE; no floor formula is baked in here.
+
+FORMAT (one JSON object per line, ``sort_keys``; every record has ``"k"`` = record kind and ``"schema"``):
+  k="hdr"  once per writer (= once per ignition / card start): schema, t_wall, shadow law constants, note.
+  k="f"    one FRAME record per 50 Hz send slot while the shadow window is OPEN (see ``ShadowLogger.frame``):
+             t_wall, frame, t_since_engage, v_ego_mps, a_ego_mps2, ask_mps2 (raw planner accel = CC.actuators.accel),
+             ask_law_mps2 (the ask the law consumed: clipped to -FCA11_A_MAX_MSS2, the PID bound the actuating arm
+             would have had), camera_requesting (bool), camera_request_level (the camera's own CR_VSM_DecCmd raw LSB,
+             byte 1 of the freshest bus-2 0x38D; null with no frame), camera_warn (CF_VSM_Warn bits), cam_hex (raw
+             camera frame), shaped_lsb_wouldbe (the v3 law's would-be SENT CR_VSM_DecCmd this slot; 0 = passive/none),
+             shaped_send_wouldbe (a 0x38D would have gone out this slot: actuating or the passive close frame),
+             shaped_target_lsb (the v3 level target before slew/hold/+4 clamps), deployed_law_lsb (the UNSHAPED instant
+             mapping of the same ask: clamp_dec_cmd(dec_cmd_from_accel(ask)), 0 above the onset ask),
+             deployed_wouldbe_lsb (the deployed 0.67 law's full state machine would-be SENT level), tier_cap,
+             personality, engaged, long_active, braking_wouldbe, held_band, latched (blocked_until_resume),
+             hc_unavailable (the 0042 surfaced fca11_unavailable of the shadow core), hard_cut, pedal_cut,
+             excl_reason (the core's fca11_ok why-not, null when ok), episode_id (null outside an episode),
+             standstill, gas_pressed, brake_pressed, lead_drel_m, lead_vrel_mps, alert_bits_wouldbe
+             (1 supervise-stop | 2 stop-complete | 4 brake-now, as the actuating build would have raised them).
+  k="ep"   one EPILOGUE per would-be episode (shaped core braking true -> false): episode_id, frame/t bounds,
+             duration_s, n_frames, n_sent, shaped min/max/last, deployed_law max, deployed_wouldbe max, cap-hit and
+             hold-band frame counts, v start/min/end, ask min, camera_request_seen, end_reason, tier_cap.
+  k="trunc" once if the per-drive byte bound is hit (nothing further is written this drive).
+
+COUNTERFACTUAL NOTE (read before analysing): the car is NOT braked by this build. The would-be streams are computed
+OPEN-LOOP against the vehicle as it actually moved (stock behaviour), assuming every would-be frame were accepted
+by the panda (no echo verdicts exist in shadow). They are NOT the closed-loop trajectory v3 would have produced.
+
+WHERE / SIZE
+Directory = the FCA11 log dir convention (fca11_log.FCA11_LOG_DIR = /data/fca11-log, env FCA11_LOG_DIR; "0"
+disables I/O). File ``fca11-shadow.jsonl``. Per-drive bound: at construction the previous drive's file rotates to
+``.1`` (.1 -> .2 ... up to FCA11_SHADOW_KEEP generations; the oldest is dropped) and a drive writes at most
+FCA11_SHADOW_MAX_BYTES (then one k="trunc" record). Writes are buffered and flushed ~1/s and at every episode end;
+every OSError is swallowed (a log must never take card down).
+"""
+import json
+import os
+import time
+
+from opendbc.sunnypilot.car.hyundai import fca11_log
+
+FCA11_SHADOW_FILE = "fca11-shadow.jsonl"
+FCA11_SHADOW_SCHEMA = 1
+FCA11_SHADOW_MAX_BYTES = 25 * 1024 * 1024   # per drive
+FCA11_SHADOW_KEEP = 5                        # previous drives kept (.1 newest .. .5 oldest)
+FCA11_SHADOW_FLUSH_RECORDS = 50              # ~1 s of 50 Hz frame records
+# the shadow WINDOW (when frame records are written): open while the shaped core is braking, the ask is at/below the
+# release threshold, or the camera is requesting; plus PRE/POST context of this many 50 Hz records (1 s each).
+FCA11_SHADOW_CONTEXT_RECORDS = 50
+
+FRAME_FIELDS = (
+  "t_wall", "frame", "t_since_engage", "v_ego_mps", "a_ego_mps2", "ask_mps2", "ask_law_mps2", "camera_requesting",
+  "camera_request_level", "camera_warn", "cam_hex", "shaped_lsb_wouldbe", "shaped_send_wouldbe", "shaped_target_lsb",
+  "deployed_law_lsb", "deployed_wouldbe_lsb", "tier_cap", "personality", "engaged", "long_active", "braking_wouldbe",
+  "held_band", "latched", "hc_unavailable", "hard_cut", "pedal_cut", "excl_reason", "episode_id", "standstill",
+  "gas_pressed", "brake_pressed", "lead_drel_m", "lead_vrel_mps", "alert_bits_wouldbe",
+)
+EPILOGUE_FIELDS = (
+  "episode_id", "frame_start", "frame_end", "t_wall_start", "t_wall_end", "duration_s", "n_frames", "n_sent",
+  "shaped_min", "shaped_max", "shaped_last", "deployed_law_max", "deployed_wouldbe_max", "cap_hit_frames",
+  "held_band_frames", "v_start_mps", "v_min_mps", "v_end_mps", "ask_min_mps2", "camera_request_seen", "end_reason",
+  "tier_cap",
+)
+
+
+def resolve_dir(dir_path=None):
+  """explicit dir (tests / offline tools) > env FCA11_LOG_DIR > fca11_log.FCA11_LOG_DIR. "0" / "" = disabled."""
+  if dir_path is not None:
+    d = dir_path
+  else:
+    d = os.environ.get("FCA11_LOG_DIR", fca11_log.FCA11_LOG_DIR)
+  return d if (d and d != "0") else None
+
+
+class ShadowLogger:
+  """Buffered JSONL writer for the shadow streams. Inert (no I/O) when the dir resolves to disabled."""
+
+  def __init__(self, dir_path=None, header=None):
+    self.dir = resolve_dir(dir_path)
+    self.enabled = self.dir is not None
+    self.path = os.path.join(self.dir, FCA11_SHADOW_FILE) if self.enabled else None
+    self.bytes = 0
+    self.truncated = False
+    self.n_records = 0
+    self._buf: list[str] = []
+    self._pre: list[dict] = []        # pre-context ring (frame records not yet written)
+    self._post_left = 0
+    if self.enabled:
+      try:
+        os.makedirs(self.dir, exist_ok=True)
+        self._rotate()
+      except OSError:
+        self.enabled = False
+    self.write(dict(k="hdr", t_wall=time.time(), **(header or {})))
+
+  # ------------------------------------------------------------------ rotation / io
+  def _rotate(self) -> None:
+    for i in range(FCA11_SHADOW_KEEP - 1, 0, -1):
+      src = f"{self.path}.{i}"
+      if os.path.exists(src):
+        os.replace(src, f"{self.path}.{i + 1}")
+    if os.path.exists(self.path):
+      os.replace(self.path, f"{self.path}.1")
+
+  def write(self, rec: dict) -> None:
+    if not self.enabled or self.truncated:
+      return
+    rec.setdefault("schema", FCA11_SHADOW_SCHEMA)
+    line = json.dumps(rec, sort_keys=True, separators=(",", ":")) + "\n"
+    if self.bytes + len(line) > FCA11_SHADOW_MAX_BYTES:
+      self.truncated = True
+      self._buf.append(json.dumps(dict(k="trunc", schema=FCA11_SHADOW_SCHEMA, t_wall=time.time(), bytes=self.bytes),
+                                  sort_keys=True) + "\n")
+      self.flush()
+      return
+    self.bytes += len(line)
+    self.n_records += 1
+    self._buf.append(line)
+    if len(self._buf) >= FCA11_SHADOW_FLUSH_RECORDS:
+      self.flush()
+
+  def flush(self) -> None:
+    if not self._buf:
+      return
+    buf, self._buf = self._buf, []
+    if not self.enabled:
+      return
+    try:
+      with open(self.path, "a") as f:
+        f.write("".join(buf))
+    except OSError:
+      pass
+
+  # ------------------------------------------------------------------ windowed frame records
+  def frame(self, rec: dict, window_open: bool) -> None:
+    """Write a k="f" record if the shadow window is open (with 1 s pre/post context); otherwise keep it in the ring."""
+    rec = dict(rec, k="f")
+    if window_open:
+      for r in self._pre:
+        self.write(r)
+      self._pre = []
+      self.write(rec)
+      self._post_left = FCA11_SHADOW_CONTEXT_RECORDS
+    elif self._post_left > 0:
+      self.write(rec)
+      self._post_left -= 1
+    else:
+      self._pre.append(rec)
+      if len(self._pre) > FCA11_SHADOW_CONTEXT_RECORDS:
+        self._pre.pop(0)
+
+  def epilogue(self, rec: dict) -> None:
+    self.write(dict(rec, k="ep"))
+    self.flush()
