+# ---------------------------------------------------------------------------------------------- compute equivalence
+class TestShadowComputeEquivalence:
+  @pytest.mark.parametrize("law_on", [True, False])
+  def test_wouldbe_stream_equals_actuating_instance_sent_stream(self, law_on):
+    """shaped_lsb_wouldbe (v3) / deployed_wouldbe_lsb (0.67) == what the ACTUATING ON / OFF instance sends, frame for frame,
+    on identical inputs (the actuating instance sees the -2.0 PID bound it would have; its frames all ACCEPTED)."""
+    script = _script()
+    _, CP, CP_SP = _cp(brake="1", shaping="1", shadow="1")
+    sh = _drive(fl.Fca11LongBrake(CP, CP_SP), script)
+    _, CPa, CP_SPa = _cp(brake="1", shaping="1" if law_on else "0")
+    act = _drive(fl.Fca11LongBrake(CPa, CP_SPa), script, accel_clip=-fl.FCA11_A_MAX_MSS2)
+    n_cmp = 0
+    for (k, _, o), (k2, s, _) in zip(sh, act, strict=True):
+      want = int(s[-1].dat[1]) if s else 0
+      got = o.shaped_lsb_wouldbe if law_on else o.deployed_wouldbe_lsb
+      assert got == want, (k, got, want)
+      if law_on:
+        assert [bytes(x.dat) for x in o.wouldbe_sends] == [bytes(x.dat) for x in s], k
+      n_cmp += int(bool(s))
+    assert n_cmp > 50
+
+  def test_deployed_law_lsb_is_the_instant_mapping(self):
+    _, CP, CP_SP = _cp(shadow="1")
+    b = fl.Fca11LongBrake(CP, CP_SP)
+    for k, a, v, warn in _script(600):
+      cs = _CS(v)
+      cs.fca11_cam_frame = (k * 10_000_000, _cam())
+      cs.fca11_now_nanos = k * 10_000_000
+      b.update(_cc(a), cs, k, fl.PERSONALITY_STANDARD)
+      al = max(a, -fl.FCA11_A_MAX_MSS2)
+      want = fl.clamp_dec_cmd(fl.dec_cmd_from_accel(al), fl.PERSONALITY_STANDARD) if al <= fl.FCA11_BRAKE_ONSET_ACCEL else 0
+      assert b.shadow_out.deployed_law_lsb == want
+
+  def test_cores_never_write_the_cars_cs(self):
