+    self._sh_wire = out
+    self._sh_off_sent = dec_in           # what the law + clamp would have put on the wire (their reference next frame)
+    self.sh_frames += 1
+    self.sh_max_lvl = max(self.sh_max_lvl, out)
+    self._sh_log_frame(CS, frame, out, dec_in, acked, v, standstill)
+    return out
