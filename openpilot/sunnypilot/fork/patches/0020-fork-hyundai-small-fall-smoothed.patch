+
+
+class TestSmallFallSmoothed:
+  """2026-11-01: the measured remaining blips were single-frame falls of 5-8 LSB that the rise limit then had to walk
+  back (14 in 45.5 engaged minutes). A SMALL fall is walked down at the mirror rate; big lifts and exact zeros stay
+  immediate so the safety direction is unchanged."""
+
+  def test_small_fall_is_walked_down_not_instant(self):
+    v = 30.
+    step = gi.get_pedal_rate_down(v) * gi.DT_CTRL
+    out = gi.rate_limit_pedal_command(0.05, 0.07, v)      # 0.02 = ~5 LSB
+    assert out == pytest.approx(0.07 - step, abs=1e-9)
+
+  def test_fall_at_the_lsb_boundary_is_still_smoothed(self):
+    v = 25.
+    step = gi.get_pedal_rate_down(v) * gi.DT_CTRL
+    out = gi.rate_limit_pedal_command(0.10, 0.10 + gi.PEDAL_FALL_BLIP_LSB / 255., v)
+    assert out == pytest.approx(0.10 + gi.PEDAL_FALL_BLIP_LSB / 255. - step, abs=1e-9)
+
+  def test_large_lift_is_immediate(self):
+    out = gi.rate_limit_pedal_command(0.02, 0.20, 30.)    # 0.18 = ~46 LSB, a real lift
+    assert out == pytest.approx(0.02, abs=1e-9)
+
+  def test_zero_still_falls_in_one_frame(self):
+    assert gi.rate_limit_pedal_command(0., 0.05, 30.) == 0.
+
+  def test_rise_limit_is_untouched(self):
+    out = gi.rate_limit_pedal_command(0.30, 0.10, 30.)
+    assert out == pytest.approx(0.10 + gi.get_pedal_rate_up(30.) * gi.DT_CTRL, abs=1e-9)
