+    self.assertIn(dm.MARK_SOURCE_TOUCH2, note)
+    self.assertIn("swipe", note.lower(), "and the GOOD one")
+    self.assertEqual(dm.MARK_GAP_S, hdr[0]["mark_gap_s"])
+    self.assertEqual(dm.MARK_PAIR_DEDUP_S, hdr[0]["mark_pair_dedup_s"])
