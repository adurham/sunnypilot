+    self.brake.on_driver_mark("bad", dm.MARK_SOURCE_TOUCH2, snap)
+    hdr = [r for r in self._records() if r.get("k") == "hdr"]
+    self.assertEqual(1, len(hdr), "the header is written once, when the stream opens")
+    note = hdr[0]["note"]
