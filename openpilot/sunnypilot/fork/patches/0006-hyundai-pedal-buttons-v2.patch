     self.safety.set_controls_allowed(True)
     self._release()
     self._press(Buttons.CANCEL, 1)
     self.assertFalse(self.safety.get_controls_allowed())
     self._press(Buttons.CANCEL)
-    self._release(20)
     self.assertFalse(self.safety.get_controls_allowed())
