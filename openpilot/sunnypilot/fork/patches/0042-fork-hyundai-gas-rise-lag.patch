+  def test_pedal_never_exceeds_the_unlagged_pedal(self):
+    """Opus defect 1 / probe P1: the small-fall walk started from the LOWER lagged level and held the pedal above the
+    unlagged law (+7.4 LSB, 13 frames at v=15, ask 0 -> +0.2 for 0.2 s -> -0.1). The lag may only hold a rise back, so
+    on every frame of the whole grid the lagged pedal must be <= the pedal the unlagged law commands."""
+    worst = -1e9
+    below = 0
+    for v in (8., 15., 25.):
+      for a1 in (0.2, 0.3, 1.0):
+        for n1 in (20, 50):
+          for a2 in (0.1, 0.0, -0.1, -0.6):
+            series = [(0.0, v, True, False, False, 255.)] * 60 + [(a1, v, True, False, False, 255.)] * n1 + \
+                     [(a2, v, True, False, False, 255.)] * 40
+            on = self._run(self._ci(True), series)
+            off = self._run(self._ci(False), series)
+            d = [o[1] - f[1] for o, f in zip(on, off)]
+            worst = max(worst, max(d))
+            below += sum(1 for x in d if x < -1e-6)
+    assert worst <= 0., worst            # NEVER above the unlagged pedal, on any frame
+    assert below > 100                   # ... and the lag really is in play (the check is not vacuous)
+
+  def test_never_exceeds_max_ask_prev_on_a_rise_and_equals_the_ask_on_a_fall(self):
+    """Through the real controller (Opus defect 6): the pure function was pinned, the path the car runs was not."""
+    rng = np.random.default_rng(42)
+    ask = 0.0
+    series = []
+    for _ in range(1200):
+      ask = float(np.clip(ask + rng.normal(0., 0.15) * (1. if rng.random() < 0.05 else 0.05), -2.0, 2.0))
+      series.append((ask, 20.0, True, False, False, 255.))
+    CI, CI_off = self._ci(True), self._ci(False)
+    out = self._run(CI, series)
+    ref = self._run(CI_off, series)
+    rises = falls = 0
+    prev_state = 0.0
+    for (want, _v, _a, _b, _g, _c), (got, pedal), (_x, pedal_off) in zip(series, out, ref):
+      if want <= prev_state + 1e-9:                          # transparent frame: the ask IS the state
+        assert got == pytest.approx(want, abs=2e-6), (want, got)
+        falls += 1
+      else:
+        assert prev_state <= got <= want + 2e-6, (prev_state, got, want)   # never ABOVE the ask
+        rises += 1
+      assert got <= want + 2e-6                        # never ABOVE the ask, never a new accel
+      assert pedal <= pedal_off + 1e-9, (want, pedal, pedal_off)
+      prev_state = got
+    assert rises > 100 and falls > 100
+    # the pure function keeps its own exact bound too
+    prev = 0.0
+    for a in (0.3, 0.9, 0.2, -1.0, 0.4):
+      o = gi.filter_gas_rise(a, prev)
+      assert (o == a) if a <= prev else (prev <= o <= a)
+      prev = o
