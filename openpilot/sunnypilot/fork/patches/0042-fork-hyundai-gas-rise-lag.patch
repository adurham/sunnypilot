+                        ("inactive", (0.0, self.V, False, False, False, self.SET_KPH))):
+      CI = self._ci(True)
+      warm = [(0.0, self.V, True, False, False, self.SET_KPH)] * 2 + \
+             [(0.6, self.V, True, False, False, self.SET_KPH)] * 10
+      self._run(CI, warm)
+      assert CI.CC.gas_ask < 0.6                                     # lagging before the reset
+      ask = self._run(CI, [frame])[0][0]
+      assert ask == pytest.approx(frame[0], abs=2e-6), (name, ask)   # re-seeded to the current ask
