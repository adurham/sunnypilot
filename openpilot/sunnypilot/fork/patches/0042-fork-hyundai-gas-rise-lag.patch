+def _get_ci_rise(rise: bool, pedal=REM):
+  """CarInterface with the pedal armed and the 0042 ask lag (HyundaiGasRiseLag) on/off."""
+  fingerprint = {i: {} for i in range(8)}
+  fingerprint[0] = {**BASE_FINGERPRINT, **pedal}
+  CarInterface = interfaces[CAR_UNDER_TEST]
+  CP = CarInterface.get_params(CAR_UNDER_TEST, fingerprint, [], alpha_long=False, is_release=False, docs=False)
+  CP_SP = CarInterface.get_params_sp(CP, CAR_UNDER_TEST, fingerprint, [], alpha_long=False, is_release_sp=False, docs=False)
+  params_list: list = [{"HyundaiGasInterceptor": True}]
+  if rise:
+    params_list.append({"HyundaiGasRiseLag": True})
+  setup_interfaces(CarInterface, CP, CP_SP, params_list)
+  return CarInterface, CP, CP_SP
+
+
+class TestGasRiseLag42:
+  """0042-Z: rise-only first-order lag on the accel ask (HyundaiGasRiseLag, default OFF).
+
+  The lag lives BEFORE the pedal law, in the ASK domain, so these tests drive the real
+  GasInterceptorCarController through CarInterface.apply (the same path the car runs) and read the state the law
+  consumes. The wire-level OFF identity is checked against a filter pinned to identity (the deployed path).
+  """
+  V = 20.0
+  SET_KPH = 108.
+
+  def _ci(self, rise=True):
+    CarInterface, CP, CP_SP = _get_ci_rise(rise)
+    assert CP_SP.gasRiseLag is rise
+    return CarInterface(CP, CP_SP)
+
+  @staticmethod
+  def _sp(mode=1):
+    sp = structs.CarControlSP()
+    sp.driveMode = int(mode)
+    return sp
+
+  def _run(self, CI, series):
+    """[(accel, v_ego, long_active, brake, gas, v_cruise_kph)] per 100 Hz frame -> (gas_ask, gas) per frame."""
+    out = []
+    for i, (accel, v, active, brake, gas, vc) in enumerate(series):
+      CC = structs.CarControl()
+      CC.enabled = CC.latActive = True
+      CC.longActive = bool(active)
+      CC.actuators.accel = float(accel)
+      CI.update([])
+      CI.CS.out.vEgo = float(v)
+      CI.CS.out.vCruise = float(vc)
+      CI.CS.out.brakePressed = bool(brake)
+      CI.CS.out.gasPressed = bool(gas)
+      CI.apply(CC.as_reader(), self._sp(1), i * int(DT_CTRL * 1e9))
+      out.append((CI.CC.gas_ask, CI.CC.gas))
+    return out
+
+  def _wire(self, CI, series):
+    """The 0x700 command bytes per SEND SLOT (even frames) - what the pedal actually receives."""
+    out = []
+    for i, accel in enumerate(series):
+      CC = structs.CarControl()
+      CC.enabled = CC.latActive = CC.longActive = True
+      CC.actuators.accel = float(accel)
+      CI.update([])
+      CI.CS.out.vEgo = 25.0
+      CI.CS.out.vCruise = 108.
+      CI.CS.out.brakePressed = False
+      CI.CS.out.gasPressed = False
+      _, sends = CI.apply(CC.as_reader(), self._sp(1), i * int(DT_CTRL * 1e9))
+      for a, d, _ in sends:
+        if a == gi.REMAPPED_IDS.command_addr:
+          out.append((i, bytes(d)))
+    return out
+
+  # ---- the switch ---------------------------------------------------------------------------------------------------
+  def test_param_defaults_off_and_reads_the_key(self):
+    _, _, off = _get_ci_rise(False)
+    assert off.gasRiseLag is False
+    assert off.enableGasInterceptor is True
+    for val, want in ((True, True), ("1", True), (b"1", True), (False, False), ("0", False), ("true", False), (2, False)):
+      fingerprint = {i: {} for i in range(8)}
+      fingerprint[0] = {**BASE_FINGERPRINT, **REM}
+      CarInterface = interfaces[CAR_UNDER_TEST]
+      CP = CarInterface.get_params(CAR_UNDER_TEST, fingerprint, [], alpha_long=False, is_release=False, docs=False)
+      CP_SP = CarInterface.get_params_sp(CP, CAR_UNDER_TEST, fingerprint, [], alpha_long=False, is_release_sp=False, docs=False)
+      setup_interfaces(CarInterface, CP, CP_SP,
+                       [{"HyundaiGasInterceptor": True}, {"HyundaiGasRiseLag": val}])
+      assert CP_SP.gasRiseLag is want, (val, CP_SP.gasRiseLag)
+
+  # ---- the four behaviours the brief names ---------------------------------------------------------------------------
+  def test_rise_is_lagged_and_bounded_by_the_ask(self):
+    CI = self._ci(True)
+    series = [(0.0, self.V, True, False, False, self.SET_KPH)] * 2 + \
+             [(1.0, self.V, True, False, False, self.SET_KPH)] * 60
+    out = self._run(CI, series)
+    asks = [o[0] for o in out]
+    # first rise frame: one dt of a tau=0.6 s first-order response, NOT the ask
+    assert asks[2] == pytest.approx(1.0 - np.exp(-DT_CTRL / gi.GAS_RISE_LAG_TAU_S), abs=1e-9)
+    assert asks[2] < 0.02
+    # monotone, strictly below the ask, and ~63 % after one tau
+    for prev, cur in zip(asks[2:], asks[3:]):
+      assert prev <= cur < 1.0
+    assert asks[-1] == pytest.approx(1.0 - np.exp(-0.60 / gi.GAS_RISE_LAG_TAU_S), abs=2e-3)
+
+  def test_fall_passes_through_on_the_same_frame(self):
+    CI = self._ci(True)
+    up = [(0.0, self.V, True, False, False, self.SET_KPH)] * 2 + \
+         [(1.0, self.V, True, False, False, self.SET_KPH)] * 100
+    out = self._run(CI, up)
+    assert out[-1][0] < 1.0                      # still lagging upward
+    for ask, want in ((0.2, 0.2), (0.0, 0.0), (-1.0, -1.0), (-2.0, -2.0)):
+      CI.update([])
+      CC = structs.CarControl()
+      CC.enabled = CC.latActive = CC.longActive = True
+      CC.actuators.accel = ask
+      CI.CS.out.vEgo = self.V
+      CI.CS.out.vCruise = self.SET_KPH
+      CI.apply(CC.as_reader(), self._sp(1), 0)
+      assert CI.CC.gas_ask == pytest.approx(want, abs=2e-6), (ask, CI.CC.gas_ask)   # the FALL frame IS the ask
+
