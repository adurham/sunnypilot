+  def test_launch_latch_uses_the_raw_ask(self):
+    """Mutation pin for l.829-831: replace `accel_raw` with the lagged `accel` there and this fails by VALUE.
+    Negative ask -> +0.6 at 2 m/s: the raw ask is a launch request while the lagged ask is still negative."""
+    CI = self._ci(True)
+    out = self._run(CI, [(-0.5, 2.0, True, False, False, 108.)] * 20 + [(0.6, 2.0, True, False, False, 108.)] * 20)
+    assert out[20][0] < 0.                     # the lagged ask has not crossed zero yet ...
+    assert CI.CC.gas_launching is True         # ... but the launch latch is on: it reads the RAW ask
