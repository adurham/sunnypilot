+    for name, frame in (("driver brake", (1.0, self.V, True, True, False, self.SET_KPH)),
+                        ("driver gas", (1.0, self.V, True, False, True, self.SET_KPH)),
+                        ("standstill", (1.0, 0.0, True, False, False, self.SET_KPH)),
