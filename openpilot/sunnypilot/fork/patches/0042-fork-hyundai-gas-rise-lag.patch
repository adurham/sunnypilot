+  def test_overspeed_latch_uses_the_raw_ask(self):
+    """Opus defect 2 / probe P3: 21 m/s over a 72 km/h set, raw ask -0.4 -> +0.2. With the LAGGED ask in the release
+    pair the latch held for 150 frames (ON) where OFF released on 0; both arms must now agree."""
+    series = [(0.3, 21.0, True, False, False, 255.)] * 40 + \
+             [(-0.4, 21.0, True, False, False, 255.)] * 80 + \
+             [(0.2, 21.0, True, False, False, 72.)] * 150
+    CI, CI_off = self._ci(True), self._ci(False)
+    on, off = self._run(CI, series), self._run(CI_off, series)
+    tail = slice(120, None)
+    rel_on = sum(1 for o in on[tail] if o[1] == 0.)
+    rel_off = sum(1 for o in off[tail] if o[1] == 0.)
+    assert rel_on == rel_off == 0, (rel_on, rel_off)
+    # the lagged ask is still below the exit threshold on those frames - the decision came from the RAW one
+    assert on[-1][0] < gi.OVERSPEED_EXIT_ACCEL
+    assert on[-1][1] > 0. and off[-1][1] > 0.
