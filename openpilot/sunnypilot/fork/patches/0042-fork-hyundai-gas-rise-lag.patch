+  def test_reentry_latch_uses_the_raw_ask(self):
+    """Mutation pin for l.869: replace `accel_raw` with the lagged `accel` in `reentry=` and this fails by VALUE -
+    the rise would be limited to the soft-reentry rate (hold/1.0 s) instead of the jerk rate."""
+    CI = self._ci(True)
+    out = self._run(CI, [(0.0, 30.0, True, False, False, 100.)] * 20 + [(0.8, 30.0, True, False, False, 100.)] * 20)
+    assert out[25][0] < gi.OVERSPEED_EXIT_ACCEL          # lagged ask below the deliberate threshold ...
+    steps = 5                                            # ... five frames after the step
+    jerk = gi.get_pedal_rate_up(30.) * DT_CTRL           # per frame
+    soft = gi.get_pedal_reentry_rate(30.) * DT_CTRL      # per frame
+    assert jerk > 3. * soft                              # the two paths are separable
+    assert out[20 + steps][1] == pytest.approx((steps + 1) * jerk, abs=1e-4)
