+  # ---- the switch, and OFF = the deployed path ----------------------------------------------------------------------
+  def test_off_is_the_deployed_path_and_bypassing_the_lag_reproduces_it(self):
+    series = ([(1.2, 1.0)] * 40 + [(0.0, 18.0)] * 60 +
+              [(0.3 if k % 7 else 0.06, 25.0) for k in range(400)] +
+              [(-0.05 if k % 4 else -0.20, 25.0) for k in range(100)] + [(0.9, 25.0)] * 60)
+    rows = [(a, v, True, False, False, 108.) for a, v in series]
+    off = self._wire(self._ci(False), [a for a, _ in series])
+    # the OFF controller's ask state IS the raw ask on every frame, and the lag never marks a frame
+    CI_off = self._ci(False)
+    asks = self._run(CI_off, rows)
+    assert all(o[0] == pytest.approx(a, abs=2e-6) for o, (a, _v) in zip(asks, series))
+    assert CI_off.CC._gas_lagging is False
+    assert len(off) == len([1 for i, _ in enumerate(series) if i % 2 == 0])
+    # bypassing the flag on an ON controller IS the deployed path, byte for byte: nothing of 0042 runs outside its block
+    CI_bypass = self._ci(True)
+    CI_bypass.CC.gas_rise_lag = False
+    assert self._wire(CI_bypass, [a for a, _ in series]) == off
+    # and the real filter DOES change the wire on that same series (the test is not vacuous)
+    assert self._wire(self._ci(True), [a for a, _ in series]) != off
