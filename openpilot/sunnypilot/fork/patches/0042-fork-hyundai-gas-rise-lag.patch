+  def test_rolling_reengage_starts_at_its_own_ask(self):
+    """Opus defect 3 / probe P2: on the car LongControl outputs 0 while inactive, so the old reset re-seeded the
+    state to 0 on every inactive frame and the first active frame was a rise FROM 0 (20 m/s, raw 0.5 -> 0.0083).
+    Realistic asks here: 0 on the inactive frames, and the re-engagement must land on its own ask."""
+    CI = self._ci(True)
+    out = self._run(CI, [(0.0, 20.0, False, False, False, 255.)] * 50 +
+                        [(0.5, 20.0, True, False, False, 255.)] * 5)
+    assert out[50][0] == pytest.approx(0.5, abs=2e-6)     # NOT 0.0083
+    assert out[50][1] == pytest.approx(self._run(self._ci(False), [(0.0, 20.0, False, False, False, 255.)] * 50 +
+                                                              [(0.5, 20.0, True, False, False, 255.)] * 1)[50][1],
+                                        abs=1e-9)
+    # a stale value is still never carried in: the state re-seeds to whatever the first active frame asks
+    CI = self._ci(True)
+    out = self._run(CI, [(0.0, 20.0, True, False, False, 255.)] * 30 +
+                        [(0.9, 20.0, True, False, False, 255.)] * 20 +
+                        [(0.0, 20.0, False, False, False, 255.)] * 3 +
+                        [(0.4, 20.0, True, False, False, 255.)])
+    assert out[-1][0] == pytest.approx(0.4, abs=2e-6)
