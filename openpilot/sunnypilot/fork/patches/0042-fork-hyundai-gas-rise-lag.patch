+  def test_never_exceeds_max_ask_prev_on_a_rise_and_equals_the_ask_on_a_fall(self):
+    rng = np.random.default_rng(42)
+    ask = 0.0
+    prev = 0.0
+    rises = falls = 0
+    for _ in range(20000):
+      ask = float(np.clip(ask + rng.normal(0., 0.15) * (1. if rng.random() < 0.05 else 0.05), -2.0, 2.0))
+      out = gi.filter_gas_rise(ask, prev)
+      if ask <= prev:
+        assert out == ask, (ask, prev, out)
+        falls += 1
+      else:
+        assert prev <= out <= ask                                     # never ABOVE the ask, never a new accel
+        assert out <= max(ask, prev) + 1e-12
+        rises += 1
+      prev = out
+    assert rises > 1000 and falls > 1000
