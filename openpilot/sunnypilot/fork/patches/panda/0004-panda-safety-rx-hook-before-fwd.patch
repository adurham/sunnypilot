@@ -195,6 +195,13 @@ static void can_rx(uint8_t can_number) {
     }
     can_set_checksum(&to_push);
 
+    // ORDER MATTERS (fork): the safety layer must see this frame BEFORE the forwarding decision for it.
+    // Forward hooks can arbitrate on state that rx_hook updates from this very frame: the Hyundai FCA11 camera
+    // hand-back (0x38D bus 2 -> 0 is forwarded only while cam_brake, which rx_hook sets on the first braking-class
+    // camera frame), and upstream's Honda Nidec / Tesla stock-AEB forwarding. With fwd before rx, the FIRST frame of
+    // every camera brake sequence was dropped (a 20 ms hole at AEB onset). Do not move this back below forwarding.
+    safety_rx_invalid += safety_rx_hook(&to_push) ? 0U : 1U;
+
     // forwarding
     int bus_fwd_num = safety_fwd_hook(bus_number, to_push.addr);
     if (bus_fwd_num >= 0) {
