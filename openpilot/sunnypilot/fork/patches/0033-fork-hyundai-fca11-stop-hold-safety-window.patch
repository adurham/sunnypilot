       hyundai_fca11_long_speed_min = SAFETY_MIN(SAFETY_MIN(fl, fr), SAFETY_MIN(rl, rr));
+      hyundai_fca11_long_speed_max = SAFETY_MAX(SAFETY_MAX(fl, fr), SAFETY_MAX(rl, rr));
       hyundai_fca11_long_ts_speed = ts;
