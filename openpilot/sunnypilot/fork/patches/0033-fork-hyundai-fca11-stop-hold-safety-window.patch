       bool violation = (CR_VSM_DecCmd > HYUNDAI_FCA11_LONG_MAX_DEC);
-      violation |= (CF_VSM_HBACmd != 0);
-      violation |= FCA_StopReq;
+      // 0033: the stop-hold pair is legal ONLY in the narrow standstill window (block comment at
+      // HYUNDAI_FCA11_LONG_STOP_HOLD_MIN_DEC). This only decides whether the two bits are acceptable; the frame must
+      // STILL pass every rule below (cap, DecCmdAct, Warn shape, camera-owns, controls/heartbeat, window, liveness, rise
