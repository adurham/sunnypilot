diff --git a/opendbc/safety/tests/test_hyundai.py b/opendbc/safety/tests/test_hyundai.py
index 27013a8..0133a45 100755
--- a/opendbc/safety/tests/test_hyundai.py
+++ b/opendbc/safety/tests/test_hyundai.py
@@ -2797,12 +2797,155 @@ class TestHyundaiFca11LongSafety(TestHyundaiNonSCCGasInterceptorSafety):
     self.assertEqual(self.DEC_CAP, HYUNDAI_FCA11_LONG_MAX_DEC)
 
   def test_hba_stopreq_dec_cmd_act_blocked(self):
+    # 0033: OUTSIDE the stop-hold window (here: 20 km/h, dec 1) every HBA / StopReq combination is still refused, and
+    # DecCmdAct stays refused everywhere (variant B).
     self._open_window()
     for hba in (1, 2, 3):
       self.assertFalse(self._tx(self._fca11(dec=1, prefill=1, warn=3, hba=hba, cmd_act=1)))
     self.assertFalse(self._tx(self._fca11(dec=1, prefill=1, warn=3, cmd_act=1, stop_req=1)))
+    self.assertFalse(self._tx(self._fca11(dec=1, prefill=1, warn=3, cmd_act=1, hba=1, stop_req=1)))
     self.assertFalse(self._tx(self._fca11(dec=1, prefill=1, warn=3, cmd_act=1, dec_cmd_act=1)))  # variant B: DecCmdAct stays 0
 
+  # *** 0033: the narrow ESC stop-hold window (FCA_StopReq + CF_VSM_HBACmd == 1) ***
+
+  STOP_HOLD_MIN_DEC = 7     # == HYUNDAI_FCA11_LONG_STOP_HOLD_MIN_DEC (the law's FCA11_CRAWL_MIN_LSB)
+  WALK_RAW = 5 * 32         # == HYUNDAI_FCA11_ROLL_MIN_SPEED (160 raw = 5 km/h), the fastest-wheel bound
+
+  def _hold_cmd(self, dec, hba=1, stop_req=1, warn=3, cmd_act=1, dec_cmd_act=0, prefill=1):
+    return self._fca11(dec=dec, prefill=prefill, warn=warn, cmd_act=cmd_act, dec_cmd_act=dec_cmd_act, hba=hba,
+                       stop_req=stop_req)
+
+  def _hold_ready(self, speed_raw=0, dec=8):
+    """Fresh arm, window open at `speed_raw`, a legal plain variant-B ramp up to `dec` (so the rise gate allows `dec`)."""
+    self._rearm()
+    self._open_window(speed_raw)
+    self.assertTrue(self._tx_brake(dec), "precondition: the plain ramp is accepted")
+
+  def test_stop_hold_constants_pinned(self):
+    from opendbc.sunnypilot.car.hyundai import fca11_long as fl
+    self.assertEqual(self.STOP_HOLD_MIN_DEC, fl.FCA11_CRAWL_MIN_LSB)
+    self.assertEqual(self.WALK_RAW, HYUNDAI_FCA11_ROLL_MIN_SPEED_KPH * self.RAW_PER_KPH)
+    h = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "modes", "hyundai.h")
+    with open(h) as f:
+      src = f.read()
+    self.assertRegex(src, r"#define HYUNDAI_FCA11_LONG_STOP_HOLD_MIN_DEC %d\b" % self.STOP_HOLD_MIN_DEC)
+    self.assertRegex(src, r"#define HYUNDAI_FCA11_ROLL_MIN_SPEED %dU\b" % self.WALK_RAW)
+
+  def test_stop_hold_accepted_at_standstill(self):
+    """(a) the narrow window ACCEPTS: standstill, a valid actuating variant-B frame, a hold level >= 7 LSB. FALSIFIABLE
+    CONTRAST: refused on the 32-patch tree (HBA/StopReq were unconditionally a violation)."""
+    for raw in (0, 1, self.WALK_RAW):
+      with self.subTest(raw=raw):
+        self._hold_ready(raw, dec=8)
+        self.assertTrue(self._tx(self._hold_cmd(8)), f"raw {raw}: stop-hold frame must be accepted")
+    # exactly the hold level, and a long hold at the cap, all accepted
+    self._hold_ready(0, dec=self.STOP_HOLD_MIN_DEC)
+    self.assertTrue(self._tx(self._hold_cmd(self.STOP_HOLD_MIN_DEC)))
+    self._hold_ready(0, dec=self.DEC_CAP)
+    for i in range(250):
+      self.safety.set_timer(1000000 + (i + 1) * self.PERIOD_MS * 1000)
+      self._feed_inputs(speed_raw=0)
+      self.assertTrue(self._tx(self._hold_cmd(self.DEC_CAP)), f"hold frame {i}")
+    # releasing the bits again (plain frame) and then a passive close are accepted: the lane never wedges
+    self.assertTrue(self._tx(self._brake_cmd(self.DEC_CAP)))
+    self.assertTrue(self._tx(self._fca11()))
+
+  def test_stop_hold_keeps_cap_and_rise_gate(self):
+    # the bits add NO decel authority: the 46 LSB cap and the +RATE_STEP rise gate apply unchanged
+    self._hold_ready(0, dec=self.DEC_CAP)
+    self.assertFalse(self._tx(self._hold_cmd(self.DEC_CAP + 1)), "cap")
+    self._rearm()
+    self._open_window(0)
+    self.assertFalse(self._tx(self._hold_cmd(8)), "onset: 0 -> 8 exceeds RATE_STEP even with the hold bits")
+    self._hold_ready(0, dec=8)
+    self.assertFalse(self._tx(self._hold_cmd(8 + HYUNDAI_FCA11_LONG_RATE_STEP + 1)), "rise gate")
+    self.assertTrue(self._tx(self._hold_cmd(8 + HYUNDAI_FCA11_LONG_RATE_STEP)))
+
+  def test_stop_hold_refused_below_hold_level(self):
+    # StopReq without a real hold behind it is refused (the plain frame at the same level is fine)
+    for dec in (1, 4, self.STOP_HOLD_MIN_DEC - 1):
+      with self.subTest(dec=dec):
+        self._hold_ready(0, dec=dec)
+        self.assertFalse(self._tx(self._hold_cmd(dec)))
+        self.assertTrue(self._tx(self._brake_cmd(dec)))
+
+  def test_stop_hold_refused_above_walking_pace(self):
+    """(b) the same bits are refused above walking pace, judged on the FASTEST wheel (one slow/stuck wheel can never
+    make a moving car look stopped). The plain frame at the same speed and level stays accepted."""
+    for wheels in ([self.WALK_RAW + 1] * 4, [self.IN_WINDOW_RAW] * 4, [100 * self.RAW_PER_KPH] * 4,
+                   [0, 0, 0, self.WALK_RAW + 1], [self.IN_WINDOW_RAW, 0, 0, 0], [0, self.IN_WINDOW_RAW, 0, 0]):
+      with self.subTest(wheels=wheels):
+        self._hold_ready(0, dec=8)
+        self._rx(self._wheel_msg(*wheels))
+        self.assertFalse(self._tx(self._hold_cmd(8)), f"{wheels}: stop hold at road speed must be refused")
+        self.assertTrue(self._tx(self._brake_cmd(8)), f"{wheels}: the plain frame is unaffected")
+
+  def test_stop_hold_refused_on_stale_speed(self):
+    self._hold_ready(0, dec=8)
+    self.safety.set_timer(1000000 + 100001)   # every input stale, speed included
+    self.assertFalse(self._tx(self._hold_cmd(8)))
+    self._feed_inputs(speed_raw=0)
+    # our stream also went stale (> TX_STALE), so the 0035 onset rule restarts the ramp from 0: hold bits or not
+    self.assertFalse(self._tx(self._hold_cmd(8)), "onset after a stale stream is still capped at RATE_STEP")
+    self.assertTrue(self._tx(self._brake_cmd(4)))
+    self.assertTrue(self._tx(self._hold_cmd(8)))
+
+  def test_stop_hold_refused_hba_2_3_and_partial_pairs(self):
+    """(c) refused at HBA 2/3, and either bit alone is refused (only the exact HBA 1 + StopReq pair is a hold)."""
+    for hba, stop_req in ((2, 1), (3, 1), (2, 0), (3, 0), (1, 0), (0, 1)):
+      with self.subTest(hba=hba, stop_req=stop_req):
+        self._hold_ready(0, dec=8)
+        self.assertFalse(self._tx(self._hold_cmd(8, hba=hba, stop_req=stop_req)))
+        self.assertTrue(self._tx(self._hold_cmd(8)))
+
+  def test_stop_hold_refused_on_bad_frame_shape(self):
+    """(d) refused when Warn is passive / not 3, when DecCmdAct is set, when FCA_CmdAct is clear, and on a passive frame."""
+    for kw in ({"warn": 0}, {"warn": 1}, {"warn": 2}, {"dec_cmd_act": 1}, {"cmd_act": 0}, {"cmd_act": 0, "dec_cmd_act": 1}):
+      with self.subTest(**kw):
+        self._hold_ready(0, dec=8)
+        self.assertFalse(self._tx(self._hold_cmd(8, **kw)))
+    self._hold_ready(0, dec=8)
+    self.assertFalse(self._tx(self._hold_cmd(0, prefill=0, cmd_act=0, warn=0)), "bits on a passive frame")
+    self.assertFalse(self._tx(self._hold_cmd(0, prefill=0, cmd_act=0, warn=3)))
+
+  def test_stop_hold_refused_while_camera_brakes(self):
+    """(e) refused while the camera is braking (camera-owns keeps priority), including the camera's OWN stop hold."""
+    for cam in ({"CR_VSM_DecCmd": 0.10}, {"FCA_StopReq": 1}, {"CF_VSM_HBACmd": 1}, {"FCA_CmdAct": 1}):
+      with self.subTest(cam=cam):
+        self._hold_ready(0, dec=8)
+        self._rx(self._cam_fca11(**cam))
+        self.assertFalse(self._tx(self._hold_cmd(8)))
+        self.assertEqual(0, self.safety.safety_fwd_hook(2, 0x38D), "the camera's frame is forwarded")
+    # ...and a camera WARNING (non-braking class) does not take FCA11 away (0053 policy unchanged)
+    self._hold_ready(0, dec=8)
+    self._rx(self._cam_fca11(CF_VSM_Warn=2, CF_VSM_Prefill=1))
+    self.assertTrue(self._tx(self._hold_cmd(8)))
+
+  def test_stop_hold_refused_outside_window(self):
+    # every other actuation gate still refuses the hold frame: disengaged, stale heartbeat, driver brake, gear != D,
+    # gas pressed, pedal fault, stale host
+    def disengaged():
+      self._engage(False, True)
+    def hb_stale():
+      self._engage(True, False)
+    def brake():
+      self._rx(self._user_brake_msg(True))
+    def gear():
+      self._rx(self._gear_msg(4))
+    def gas():
+      self._rx(self._interceptor_user_gas(self.INTERCEPTOR_THRESHOLD + 1))
+    def fault():
+      self._rx(self._interceptor_user_gas(0, state=1))
+    def host_stale():
+      self.safety.set_timer(1000000 + HYUNDAI_FCA11_LONG_HOST_HB_TIMEOUT_US + 100000)
+      self._feed_inputs(speed_raw=0)
+    for name, fault_fn in (("disengaged", disengaged), ("hb_stale", hb_stale), ("brake", brake), ("gear", gear),
+                           ("gas", gas), ("fault", fault), ("host_stale", host_stale)):
+      with self.subTest(name):
+        self._hold_ready(0, dec=8)
+        fault_fn()
+        self.assertFalse(self._tx(self._hold_cmd(8)), name)
+
   def test_warn_shape_policed(self):
     self._open_window()
     # actuating frames must carry Warn 3; passive frames must carry Warn 0
