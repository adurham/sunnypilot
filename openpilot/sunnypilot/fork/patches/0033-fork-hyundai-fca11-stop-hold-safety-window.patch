+        stop_hold_ok = stop_hold_ok && FCA_CmdAct && !CF_VSM_DecCmdAct && (CF_VSM_Warn == 3);
+        stop_hold_ok = stop_hold_ok && (CR_VSM_DecCmd >= HYUNDAI_FCA11_LONG_STOP_HOLD_MIN_DEC);
+        stop_hold_ok = stop_hold_ok && ((hyundai_fca11_long_seen & HYUNDAI_LONG_SEEN_SPEED) != 0U) &&
+                       hyundai_fca11_long_fresh(microsecond_timer_get(), hyundai_fca11_long_ts_speed) &&
+                       (hyundai_fca11_long_speed_max <= HYUNDAI_FCA11_ROLL_MIN_SPEED);
