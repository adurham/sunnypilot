+class TestMarkSnapshotAcceptsCapnpCarState(TestMarkRecord):
+  """REGRESSION, route 18e 2026-11-03 17:49: card calls mark_snapshot with carState (capnp), which has no `.out`
+  member, and `CS.out.aEgo` raised AttributeError -> card exit 1 -> no carState, no engagement for the rest of the
+  drive. The snapshot must accept EITHER object: the opendbc CarState (has `.out`) or a capnp carState (IS the out)."""
+
+  def _capnp_cs(self):
+    cs = structs.CarState.new_message()
+    cs.vEgo = 13.7
+    cs.aEgo = -0.31
+    cs.gasPressed = True
+    cs.brakePressed = False
+    cs.standstill = False
+    return cs
+
+  def test_capnp_carstate_does_not_raise_and_reports_its_own_numbers(self):
+    snap = self.brake.mark_snapshot(self._capnp_cs(), now_nanos=1_000_000_000, frame=7)
+    self.assertAlmostEqual(13.7, snap["v_ego_mps"], places=3)
+    self.assertAlmostEqual(-0.31, snap["a_ego_mps2"], places=3)
+    self.assertTrue(snap["gas_pressed"])
+    self.assertFalse(snap["brake_pressed"])
+    self.assertFalse(snap["lead_present"], "a capnp carState carries no fork lead fields -> absent, never 0")
+
+  def test_the_opendbc_carstate_path_is_unchanged(self):
+    cs = _CS(v_ego=12.5, a_ego=-0.42, gas=False, brake=True)
+    snap = self.brake.mark_snapshot(cs, now_nanos=1, frame=1)
+    self.assertAlmostEqual(12.5, snap["v_ego_mps"], places=3)
+    self.assertAlmostEqual(-0.42, snap["a_ego_mps2"], places=3)
+    self.assertTrue(snap["brake_pressed"])
