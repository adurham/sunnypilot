+# The panda starts its cooldown clock on the accepted passive 0x38D (hyundai.h:970-973), which goes out on
+# the 50 Hz slot one frame later than the release on an odd-frame release. This margin keeps the Python
+# mirror a STRICT SUBSET of what the panda allows (a couple of frames of slack rather than an exact copy),
+# so the car layer never commands a frame the panda would refuse at the cooldown edge.
+FCA11_COOLDOWN_MARGIN_FRAMES = 2
 
