       # budget spent: the panda would refuse this very frame and end the episode here
       self._in_budget = False
@@ -446,9 +467,13 @@ class Fca11LongBrake:
         m = Fca11MirrorFrame(dec_cmd=dec_cmd, prefill=True, warn=3, cmd_act=True, dec_cmd_act=False)
         out = build_fca11_frame(dat, (cam_alive + 1) & 0xF, m)
