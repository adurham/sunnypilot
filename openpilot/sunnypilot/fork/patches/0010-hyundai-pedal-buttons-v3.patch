   acc_main_on_prev = false;
@@ -407,16 +408,11 @@ void hyundai_common_cruise_state_check(const bool cruise_engaged) {
 }
 
 // Gas interceptor: called on every RX message (hyundai_rx_hook), so a brake press is caught even when it falls
-// between two CLU11 samples. Brake during a pause/resume press (or its release debounce) cancels that resume,
-// and brake during a SET/RES press makes that press unable to engage.
+// between two CLU11 samples. Brake during a pause/resume press (or its release debounce) cancels that resume.
 static void hyundai_gas_interceptor_pedal_check(void) {
   if (brake_pressed) {
     hyundai_pause_armed = false;
   }
-  bool setres_active = (cruise_button_prev == HYUNDAI_BTN_SET) || (cruise_button_prev == HYUNDAI_BTN_RESUME);
-  if (setres_active && brake_pressed) {
-    hyundai_setres_brake_seen = true;
