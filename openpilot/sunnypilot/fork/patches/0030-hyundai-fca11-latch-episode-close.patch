+  def observe_echo(self, echoes) -> None:
+    """0030 (D2-iii): the car layer's half of the echo-confirmed close.
+
+    ``echoes`` is the pandad echo of every host 0x38D we sent this CAN tick: an iterable of (src, dat) with
+    src 128 = accepted / forwarded by the panda TX hook, src 192 = REJECTED by it. The panda CLOSES its
+    FCA11-long episode ONLY on an ACCEPTED passive 0x38D (safety/modes/hyundai.h:1027-1030); a refused close
+    frame leaves ``act_active`` latched, so the NEXT brake hits budget-expiry on frame 1 + a 3 s cooldown (the
+    860-frame stale defect). Until the echo for OUR close frame comes back accepted we must not treat the
+    episode as closed, and if it comes back REFUSED we must RE-OWE the close frame and retry - never start the
+    cooldown on a frame that never landed.
+
+    Called once per controller frame from create_gas_command. Inert (and byte-identical to the shipped
+    behaviour) until the first call, which is what sets ``_echo_wired``.
+    """
+    self._echo_wired = True
+    if not echoes or self._pending_echo is None:
+      return
+    pending = self._pending_echo
+    for src, dat in echoes:
+      if bytes(dat) != pending:
+        continue
+      if int(src) == 192:
+        # the close frame was REFUSED: the panda episode is STILL OPEN. Re-owe it (a later send slot retries) and
+        # do NOT start the cooldown - the panda has not started its own either.
+        self._echo_rejected = True
+        self._release_pending = True
+      else:
+        # accepted: the panda closed the episode and started its cooldown at THIS emission frame.
+        self._budget_end = self._pending_echo_frame
+      self._pending_echo = None
+      return
+
