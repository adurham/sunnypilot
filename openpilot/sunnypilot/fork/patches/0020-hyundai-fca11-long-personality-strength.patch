-      dec_cmd = clamp_dec_cmd(dec_cmd)
+      dec_cmd = clamp_dec_cmd(dec_cmd, personality)
       # rate-limit the REQUEST too (the panda enforces its own): at most +RATE_STEP (0.04 g) per
