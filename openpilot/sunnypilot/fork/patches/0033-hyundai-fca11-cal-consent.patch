+        if rep.id in self._consent_skip:          # 0033: dismissed this session -> never re-prompt
+          continue
         if not self._band_ready(rep.band_kph):
           continue
         can, why = self.budget_can_arm(rep.hold_s, frame)
@@ -638,22 +940,22 @@ class CalSequencer:
           blocked_by_budget = True
           self._last_budget_reason = why
