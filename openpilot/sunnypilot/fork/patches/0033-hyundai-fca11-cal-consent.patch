+      if self._pending is not None:
+        self._tick_pending(CC, CS, frame)
+        return
       if self.is_done:
         self._block_reason = "done"
         return
@@ -631,6 +931,8 @@ class CalSequencer:
       for rep in self._enabled_reps():
