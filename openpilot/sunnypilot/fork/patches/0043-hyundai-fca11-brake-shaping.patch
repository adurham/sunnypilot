+  def test_jerk_slew_matches_the_measured_slopes(self):
+    # cliff band: ~1 LSB per ~0.42 s; above 8: ~9 LSB/s (the two slopes the spec names)
+    self.assertAlmostEqual(0.0472, fl.shape_slew_lsb_per_sent(5), places=3)
+    self.assertAlmostEqual(0.1823, fl.shape_slew_lsb_per_sent(10), places=3)
+    self.assertAlmostEqual(2.36, fl.shape_slew_lsb_per_sent(5) / fl.FCA11_SHAPE_SENT_DT, places=1)
+    self.assertAlmostEqual(9.11, fl.shape_slew_lsb_per_sent(10) / fl.FCA11_SHAPE_SENT_DT, places=1)
