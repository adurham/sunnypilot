+      for s in b.update(self._cc(-2.0), _CS(v_ego=0.0, cam=_cam(), standstill=True), f, fl.PERSONALITY_STANDARD):
+        decs.append(fl._get_bits(s.dat, 8, 8))
+      f += 1
+    self.assertEqual([4, 8, 12, 16, 20, 24, 28, 30], decs[:8])
