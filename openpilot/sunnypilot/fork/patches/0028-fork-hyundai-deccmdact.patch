@@ -1347,6 +1347,10 @@
   setb(8, 8, int(m.dec_cmd) & 0xFF)
   setb(3, 2, int(m.warn) & 0x3)
   setb(20, 1, 1 if m.cmd_act else 0)
+  # 2026-11-03 (Fable, route 191): CF_VSM_DecCmdAct is the bit that tells the ESC to ACT on CR_VSM_DecCmd. Every actuating
+  # frame we ever sent had it at 0 - only FCA_CmdAct (the full-AEB stage) was set - and the car delivered ~1.57 m/s^2 where
+  # the law's own map predicts 2.2 at the same 20 LSB. FCA11 has no other decel channel in this fork (no 0x421/SCC12 is sent),
+  # so a decel request with the act bit clear is the most parsimonious explanation for the shortfall.
   setb(31, 1, 1 if m.dec_cmd_act else 0)
   setb(35, 4, int(cam_alive) & 0xF)
 
