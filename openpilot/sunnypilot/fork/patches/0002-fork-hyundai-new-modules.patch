+  # 12e/12f gain fit (aEgo(t+0.5 s) per unit pedal, steady pedal; driver <15 m/s, openpilot >=15 m/s), report §A.3
+  FIT_V = [2., 4.5, 7.5, 10.5, 13.5, 17.5, 22.5, 27.5, 33.]
