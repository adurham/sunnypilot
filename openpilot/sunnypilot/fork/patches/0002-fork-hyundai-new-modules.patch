+CAR_UNDER_TEST = CAR.HYUNDAI_ELANTRA_2022_NON_SCC
+BASE_FINGERPRINT = {0x260: 8, 0x371: 8, 0x386: 8, 0x394: 8, 0x251: 8, 0x4F1: 4, 0x340: 8}
+STD = {0x201: 6}
