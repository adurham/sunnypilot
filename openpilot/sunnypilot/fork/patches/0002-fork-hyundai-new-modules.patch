+    leads = [rng.random() < 0.7 for _ in range(1500)]
+    a = _run(_brake(True, False), asks, leads=leads)
+    b = _run(_brake(True, False), asks, leads=[True] * 1500)
+    self.assertEqual(a, b)
+
+  def test_feel_off_or_affine_never_runs_the_fix(self):
