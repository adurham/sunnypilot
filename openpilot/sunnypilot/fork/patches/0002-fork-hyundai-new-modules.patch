+    self.assertTrue(b2.brake_now, "persistent: a good frame alone does not clear it")
+    # clears on driver brake
+    b2.update(self._cc(-2.0), _CS(v_ego=20.0 / 3.6, cam=_cam(), brake=True), 8)
+    self.assertFalse(b2.brake_now)
