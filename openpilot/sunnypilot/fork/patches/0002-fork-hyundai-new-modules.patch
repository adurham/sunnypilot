+  def test_rotation_per_drive_and_truncation_after_parts(self, monkeypatch, tmp_path):
+    d = tmp_path / "rot"
+    for i in range(shlog.FCA11_SHADOW_KEEP + 2):
+      w = shlog.ShadowLogger(str(d), header=dict(drive=i))
+      w.flush()
+    files = sorted(os.listdir(d))
+    assert len(files) == shlog.FCA11_SHADOW_KEEP + 1     # current + KEEP generations
+    # 0052: the cap now ROTATES (see TestShadowRotateAtCap). The deployed truncation is pinned here as the FALLBACK,
+    # with the part budget spent (a single part), which must behave byte-for-byte as before 0052.
+    monkeypatch.setattr(shlog, "FCA11_SHADOW_MAX_BYTES", 2000)
+    monkeypatch.setattr(shlog, "FCA11_SHADOW_MAX_PARTS", 1)
+    before = sorted(os.listdir(d))
+    w = shlog.ShadowLogger(str(d), header={})
+    for i in range(200):
+      w.write(dict(k="f", i=i))
+    w.flush()
+    assert w.part == 1 and w.truncated                                  # one part only: no rotation at all
+    assert sorted(os.listdir(d)) == before                              # ... and no new generation was created
+    lines = (d / shlog.FCA11_SHADOW_FILE).read_text().splitlines()
+    assert json.loads(lines[-1])["k"] == "trunc"
+    assert "rot" not in {json.loads(x)["k"] for x in lines}
+    assert os.path.getsize(d / shlog.FCA11_SHADOW_FILE) < 2400
