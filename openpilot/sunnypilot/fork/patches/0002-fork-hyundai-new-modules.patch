+# ---------------------------------------------------------------------------------------------- writer rotation (0052)
+class TestShadowRotateAtCap:
+  """0052: reaching the byte cap ROTATES the file (one k="rot" closes the part, the chain shifts as at construction, the
+  next part opens with the same k="hdr" plus cont=<part>) instead of truncating the drive. Only once
+  FCA11_SHADOW_MAX_PARTS parts are used up does the deployed truncation behaviour come back."""
+
+  CAP = 2000
+  N = 200
+  HDR = dict(drive=7, oldlaw_armed=True, consts=dict(K=9.6, BITE=0.74))
+
+  def setup_method(self):
+    self._saved = (shlog.FCA11_SHADOW_MAX_BYTES, shlog.FCA11_SHADOW_MAX_PARTS)
+    shlog.FCA11_SHADOW_MAX_BYTES = self.CAP
+    shlog.FCA11_SHADOW_MAX_PARTS = 5
+
+  def teardown_method(self):
+    shlog.FCA11_SHADOW_MAX_BYTES, shlog.FCA11_SHADOW_MAX_PARTS = self._saved
+
+  def _write(self, d, n=None):
+    w = shlog.ShadowLogger(str(d), header=dict(self.HDR))
+    for i in range(self.N if n is None else n):
+      w.write(dict(k="f", i=i))
+    w.flush()
+    return w
+
+  @staticmethod
+  def _part(d, gen=None):
+    p = d / (shlog.FCA11_SHADOW_FILE if gen is None else f"{shlog.FCA11_SHADOW_FILE}.{gen}")
+    assert p.exists(), p
+    return [json.loads(x) for x in p.read_text().splitlines()]
+
+  def test_writing_continues_past_the_cap(self, tmp_path):
+    """(a) the cap is a part bound, not a drive bound: no truncation, and the last record written is on disk."""
+    d = tmp_path / "a"
+    w = self._write(d)
+    assert not w.truncated and w.part > 1                    # the drive rotated and kept writing
+    live = self._part(d)
+    assert live[0]["k"] == "hdr" and "cont" in live[0]
+    frames = [r["i"] for r in live if r["k"] == "f"]
+    assert frames and max(frames) == self.N - 1               # the final record landed in the last part
+    assert w.n_records == self.N + w.part                      # initial hdr + N frames + one hdr per continuation
+    assert "trunc" not in {r["k"] for r in live}
+
+  def test_closed_part_ends_with_rot_marker(self, tmp_path):
+    """(b) the rotated part exists and its last record is k="rot"."""
+    d = tmp_path / "b"
+    w = self._write(d)
+    assert w.part >= 2
+    for gen in range(1, w.part):                              # .1 = the last closed part, .2 the one before, ...
+      part, recs = w.part - gen, self._part(d, gen)
+      assert recs[0]["k"] == "hdr"                            # a part opens with a header ...
+      assert ("cont" not in recs[0]) if part == 1 else (recs[0]["cont"] == part)
+      assert recs[-1]["k"] == "rot"                           # ... and closes with exactly one rot marker
+      assert recs[-1]["part"] == part and 0 < recs[-1]["bytes"] <= self.CAP
+      assert sum(1 for r in recs if r["k"] == "rot") == 1
+
+  def test_live_part_starts_with_continuation_header(self, tmp_path):
+    """(c) the live file opens with k="hdr" carrying cont=2, otherwise identical to the first header."""
+    d = tmp_path / "c"
+    w = shlog.ShadowLogger(str(d), header=dict(self.HDR))
+    for i in range(400):
+      if w.part > 1:
+        break
+      w.write(dict(k="f", i=i))
+    w.flush()
+    assert w.part == 2
+    live, first = self._part(d), self._part(d, 1)
+    assert live[0]["k"] == "hdr" and live[0]["cont"] == 2
+    assert live[0]["schema"] == shlog.FCA11_SHADOW_SCHEMA
+    for r in (live[0], first[0]):                         # same constants as the first header (fresh t_wall only)
+      r.pop("t_wall")
+      r.pop("cont", None)
+    assert live[0] == first[0]
+
+  def test_no_record_lost_across_the_hop(self, tmp_path):
+    """(d) union of the parts == exactly the records written, each once."""
+    d = tmp_path / "d"
+    w = self._write(d)
+    assert w.part >= 3                                        # at least two hops at this cap/record size
+    got = []
+    for gen in [None, *range(1, w.part)]:
+      got += [r["i"] for r in self._part(d, gen) if r["k"] == "f"]
+    assert sorted(got) == list(range(self.N))
+    assert len({r["k"] for gen in [None, *range(1, w.part)] for r in self._part(d, gen)} - {"f", "hdr", "rot"}) == 0
+
+  def test_parts_exhausted_falls_back_to_trunc(self, tmp_path):
+    """(e) FCA11_SHADOW_MAX_PARTS reached: the last part truncates and the drive stops, exactly as before 0052."""
+    d = tmp_path / "e"
+    shlog.FCA11_SHADOW_MAX_PARTS = 2
+    w = self._write(d)
+    assert w.truncated and w.part == 2
+    assert sorted(os.listdir(d)) == [shlog.FCA11_SHADOW_FILE, f"{shlog.FCA11_SHADOW_FILE}.1"]
+    live = self._part(d)
+    assert live[-1]["k"] == "trunc" and live[-1]["bytes"] <= self.CAP
+    assert all(r["k"] != "rot" for r in live)                 # the last part never opens a new one
+    assert self._part(d, 1)[-1]["k"] == "rot"                 # part 1 still closed properly
+    assert max(r["i"] for r in live if r["k"] == "f") < self.N - 1     # ... and write() is gated again
+    n = w.n_records
+    w.write(dict(k="f", i=999))
+    w.flush()
+    assert w.n_records == n and "999" not in (d / shlog.FCA11_SHADOW_FILE).read_text()
+
