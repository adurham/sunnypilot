+    self.assertLess(fl.shape_dec_cmd_from_extra(fl.FCA11_SHAPE_CLIFF_HI_EXTRA - 0.2), 8)   # the cliff band is below 8
+    prev = fl.shape_dec_cmd_from_extra(0.0)
+    for i in range(1, 4001):
