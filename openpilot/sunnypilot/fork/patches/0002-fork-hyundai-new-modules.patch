+    cliff_slope = (fl.FCA11_SHAPE_CLIFF_HI_EXTRA - fl.FCA11_SHAPE_CLIFF_LO_EXTRA) / 4.0
+    self.assertAlmostEqual(fl.FCA11_SHAPE_JERK_TARGET / cliff_slope * fl.FCA11_SHAPE_SENT_DT, fl.shape_slew_lsb_per_sent(5))
