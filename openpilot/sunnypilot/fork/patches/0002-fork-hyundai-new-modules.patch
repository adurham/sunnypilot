+            continue
+          ctx = (seed, f, accel, kph, d, last)
+          self.assertGreaterEqual(d, fl.FCA11_SHAPE_FLOOR_LSB, ctx)
+          self.assertLessEqual(d, cap, ctx)
+          self.assertLessEqual(d - last, fl.HYUNDAI_FCA11_LONG_RATE_STEP, ctx)
+          last = d
