+class TestEnablement:
+  def test_no_pedal_is_identical(self):
+    _, CP_ref, CP_SP_ref = _get_ci(BASE_FINGERPRINT, None)
+    # param alone (incl. any ID-set override) must not change anything when no pedal is on the bus
