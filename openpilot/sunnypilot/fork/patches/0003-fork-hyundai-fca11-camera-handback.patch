+  def test_0053_masks_pinned_to_header_values_and_dbc(self):
+    """ONE definition of each class, pinned three ways: hyundai.h == values.py == the DBC signal layout by name."""
+    self.assertEqual(_c_define(HYUNDAI_H, "HYUNDAI_FCA11_CAM_BRAKE_MASK"), HYUNDAI_FCA11_CAM_BRAKE_MASK)
