+  # *** 0053: LOCKSTEP - one synthetic CAN sequence through the car layer AND libsafety ***
+
+  def _lockstep(self, script, engaged=True, py_lag=0, accel=-2.0):
+    """Step `script` (one camera frame per 20 ms slot = 2 controller frames) through fca11_long.Fca11LongBrake.update
+    AND libsafety, Python's own 0x38D sends going through the panda TX hook (echoes fed back the next tick, exactly as
+    pandad does). `py_lag` delays what Python sees of the camera by that many slots (USB/host latency). Returns per-slot
+    records (slot, panda_cam_brake, py_cam_brake, n_sent, n_refused)."""
+    from opendbc.car import structs
+    from opendbc.sunnypilot.car.hyundai import fca11_long as fl
+
+    cp_sp = structs.CarParamsSP()
+    cp_sp.fca11Brake = True
+    cp_sp.enableGasInterceptor = True
+    py = fl.Fca11LongBrake(structs.CarParams(), cp_sp)
+    py.log.enabled = False
+    py.cal_seq = None
+
+    class _CS:
+      pass
+    cs = _CS()
+    cs.out = structs.CarState()
+    cs.out.vEgo = 20.0
+    cs.out.gearShifter = structs.CarState.GearShifter.drive
+    cs.interceptor_state = 0
+    cs.interceptor_fault_seen = False
+    cs.fca11_wheel_min_kph = None
+
+    cc = structs.CarControl()
+    cc.enabled = engaged
+    cc.longActive = engaged
+    cc.actuators.accel = accel
+
+    self._rearm()
+    self._engage(engaged, engaged)
+    seen = []
+    echoes = []
+    out = []
+    t0 = 2000000
+    for slot, dat in enumerate(script):
+      t_us = t0 + slot * 20000
+      self.safety.set_timer(t_us)
+      self._feed_inputs()
+      self._engage(engaged, engaged)
+      self._rx(self._cam_raw(dat))                                   # the panda sees the camera first (it is ON the bus)
+      seen.append((t_us * 1000, dat))
+      py_frames = [seen[slot - py_lag]] if slot - py_lag >= 0 else []
+      n_sent = n_ref = 0
+      for sub in (0, 1):                                             # two 100 Hz controller frames per camera period
+        frame = 2 * slot + sub
+        cs.fca11_cam_frames = py_frames if sub == 0 else []
+        cs.fca11_cam_frame = py_frames[-1] if py_frames else (seen[0] if seen else None)
+        cs.fca11_now_nanos = cs.fca11_cam_frame[0] if cs.fca11_cam_frame else 0
+        cs.fca11_echoes = echoes
+        py.ingest_camera(cs, frame)
+        py.observe_echo(echoes)
+        echoes = []
+        for s in py.update(cc, cs, frame):
+          ok = self._tx(libsafety_py.make_CANPacket(s.address, 0, bytes(s.dat)))
+          n_sent += 1
+          n_ref += 0 if ok else 1
+          echoes.append((128 if ok else 192, bytes(s.dat)))
+      out.append((slot, bool(self.safety.get_hyundai_fca11_cam_brake()), bool(py.cam_brake or py._div_latched),
+                  n_sent, n_ref))
+    return py, out
+
+  def _lockstep_scripts(self):
+    idle = cam_vectors.frame()
+    warn = cam_vectors.frame(CF_VSM_Warn=1, CF_VSM_Prefill=1)
+    brk = cam_vectors.frame(CR_VSM_DecCmd=12, FCA_CmdAct=1, CF_VSM_Warn=3, CF_VSM_Prefill=1)
+    hba = cam_vectors.frame(CF_VSM_HBACmd=2)
+    scripts = {
+      # 15b-like: a ~1 s warning burst (50 frames), nothing else
+      "warn_burst": [idle] * 100 + [warn] * 50 + [idle] * 200,
+      # an AEB: braking pulses separated by gaps SHORTER than N_QUIET (one hand-back), then quiet -> resume
+      "aeb_pulses": [idle] * 60 + ([brk] * 10 + [idle] * 40) * 3 + [idle] * 200,
+      # braking frame landing exactly at N_QUIET - 1 of the count
+      "mid_count": [idle] * 60 + [brk] + [idle] * (HYUNDAI_FCA11_CAM_QUIET_FRAMES - 1) + [hba] + [idle] * 200,
+      # repeated hand-backs each fully released
+      "repeat": [idle] * 40 + ([brk] * 5 + [idle] * 120) * 4,
+    }
+    rng = random.Random(53)
+    for k in range(4):
+      seq = []
+      while len(seq) < 600:
+        seq += [rng.choice((idle, idle, idle, warn, brk, hba))] * rng.randint(1, 90)
+      scripts[f"random_{k}"] = seq
+    return scripts
+
+  def test_0053_lockstep_never_disagrees_in_the_dangerous_direction(self):
+    """Per 20 ms slot: whenever the PANDA holds the hand-back, the car layer holds it too (never Python-allows /
+    panda-denies), and every 0x38D Python sends is ACCEPTED (it never commands into a refusal). The only allowed
+    disagreement is Python withholding: exactly FCA11_CAM_QUIET_MARGIN slots per release."""
+    from opendbc.sunnypilot.car.hyundai import fca11_long as fl
+    for engaged in (True, False):
+      for name, script in self._lockstep_scripts().items():
+        with self.subTest(script=name, engaged=engaged):
+          py, recs = self._lockstep(script, engaged=engaged)
+          dangerous = [r for r in recs if r[1] and not r[2]]
+          self.assertEqual([], dangerous, "Python allowed while the panda handed back")
+          self.assertEqual(0, sum(r[4] for r in recs), "a Python 0x38D was refused")
+          withheld = sum(1 for r in recs if r[2] and not r[1])
+          releases = sum(1 for a, b in zip(recs, recs[1:], strict=False) if a[1] and not b[1])
+          self.assertEqual(withheld, releases * fl.FCA11_CAM_QUIET_MARGIN, (withheld, releases))
+          if name != "warn_burst":
+            self.assertGreater(releases, 0, "the script must exercise at least one hand-back + release")
+            if engaged:
+              last_rel = max(i for i, (a, b) in enumerate(zip(recs, recs[1:], strict=False)) if a[1] and not b[1])
+              self.assertGreater(sum(r[3] for r in recs[last_rel + 1:]), 0, "openpilot RESUMES sending after release")
+          self.assertFalse(py.fca11_unavailable or py.fca11_divergence or py._refused_cut)
+          if engaged and name == "warn_burst":
+            self.assertGreater(sum(r[3] for r in recs[150:]), 50, "openpilot kept braking through the warning burst")
+            self.assertFalse(any(r[1] or r[2] for r in recs))
+
+  def test_0053_lockstep_with_host_lag_only_in_flight_refusals(self):
+    """With Python seeing the camera ONE slot late (host latency), the panda refuses at most the frames already in
+    flight at each hand-back onset; those refusals must NOT read as a refusal wall nor as a divergence."""
+    for name, script in self._lockstep_scripts().items():
+      with self.subTest(script=name):
+        py, recs = self._lockstep(script, engaged=True, py_lag=1)
+        onsets = sum(1 for a, b in zip(recs, recs[1:], strict=False) if b[1] and not a[1])
+        self.assertLessEqual(sum(r[4] for r in recs), 2 * onsets)
+        self.assertFalse(py.fca11_unavailable, "in-flight refusals are not a wall")
+        self.assertFalse(py.fca11_divergence, "in-flight refusals are not a divergence")
+
 
