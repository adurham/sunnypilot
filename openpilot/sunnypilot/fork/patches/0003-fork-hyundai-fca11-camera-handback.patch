+  def test_0053_vector_table_tx_fwd_and_pedal(self):
+    """Every shared vector: a BRAKING-class camera frame alone blocks our 0x38D (actuating AND passive), forwards the
+    camera's own 0x38D and blocks non-zero pedal gas; a WARNING-only / PREFILL-only / neutral frame does none of it."""
+    vecs = cam_vectors.vectors()
+    self.assertGreater(len(vecs), 40)
+    for name, dat, braking, _warning in vecs:
+      with self.subTest(vector=name):
+        self._rearm()
+        self._open_window()
+        self.assertTrue(self._tx(self._brake_cmd(1)))               # our stream owns the ESC
+        self.assertEqual(-1, self.safety.safety_fwd_hook(2, 0x38D))
+        self._rx(self._cam_raw(dat))
+        self.assertEqual(braking, self.safety.get_hyundai_fca11_cam_brake())
+        self._open_window()
+        self.assertEqual(not braking, self._tx(self._brake_cmd(1)))
+        self.assertEqual(not braking, self._tx(self._fca11()))      # passive too
+        self.assertEqual(0 if braking else -1, self.safety.safety_fwd_hook(2, 0x38D))
+        # pedal: separate arm (no brake frame -> no 0038 throttle exclusivity in play)
+        self._rearm()
+        self._open_window()
+        self._rx(self._cam_raw(dat))
+        self.assertEqual(not braking, self._tx(self._interceptor_gas_cmd(0.1)))
+        self.assertTrue(self._tx(self._interceptor_gas_cmd(0)))      # a zero / clear frame always passes
