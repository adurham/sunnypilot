+  def test_0053_passive_refused_only_by_cam_brake(self):
+    """The divergence guard's premise (fca11_long.py FCA11_DIVERGENCE_*): a well-formed PASSIVE 0x38D is refused by
+    NOTHING but cam_brake - not disengaged, not a stale heartbeat, not a pedal fault, not gas held, not gear != D, not
+    a driver brake, not stale inputs."""
+    def scenarios():
+      yield "disengaged", lambda: self._engage(False, False)
+      yield "heartbeat stale", lambda: self._engage(True, False)
+      yield "pedal fault", lambda: self._rx(self._interceptor_user_gas(0, state=3))
+      yield "gas held", lambda: self._rx(self._interceptor_user_gas(HYUNDAI_GAS_INTERCEPTOR_THRESHOLD + 100))
+      yield "gear P", lambda: self._rx(self._gear_msg(0))
+      yield "driver brake", lambda: self._rx(self._user_brake_msg(True))
+      yield "inputs stale", lambda: self.safety.set_timer(1000000 + 5000000)
+    for name, fault in scenarios():
+      with self.subTest(scenario=name):
+        self._rearm()
+        self._open_window()
+        fault()
+        self.assertFalse(self._tx(self._brake_cmd(1)), "the actuating frame IS refused")
+        self.assertTrue(self._tx(self._fca11()), "the passive frame is NOT")
+        self._rx(self._cam_brake_frame())
+        self.assertFalse(self._tx(self._fca11()), "... except while the camera brakes")
