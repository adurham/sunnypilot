+    CI.CC.create_gas_command(self._cc(1.0, engaged=False, long_active=False), cs, 0, 0)
+    self.assertTrue(CI.CC.fca11_brake.cam_brake)
+    sends = CI.CC.create_gas_command(self._cc(1.0), cs, 2, 0)        # engaged + a gas ask while the camera brakes
+    self.assertEqual(0., CI.CC.gas)
+    self.assertFalse(any(int(a) == fl.FCA11_ADDR for a, _d, _s in sends))
+    self.assertTrue(cs.fca11_camera_braking)
+
+  # ---- probation ----
+
+  def _brake_stream(self, b, f, n, verdict):
+    """n camera periods of a hard ask; each sent frame's echo is decided by verdict(i) (True = accepted)."""
+    from opendbc.sunnypilot.car.hyundai.tests import fca11_cam_vectors as cv
+    echoes = []
+    for i in range(n):
+      sends = self._step(b, cv.frame(), f, echoes=echoes)
+      f += 2
+      echoes = [(128 if verdict(i) else 192, bytes(x.dat)) for x in sends]
+    return f
+
+  def test_probation_catches_an_intermittent_wall_after_resume(self):
+    """After every (re)engage: accept 1 / refuse 2 never makes 3 CONSECUTIVE, so the 0042 rule alone never fires;
+    the cumulative probation count does, within the first 50 actuating echoes, and it does not self-heal mid-window."""
+    b = self._brake()
+    self._brake_stream(b, 0, 40, lambda i: i % 3 == 0)
+    self.assertTrue(b._refused_cut, "probation trips on an intermittent wall")
+    self.assertTrue(b.fca11_unavailable)
+    # contrast: the SAME stream after probation has expired does not trip (the consecutive rule is the steady state)
+    b2 = self._brake()
+    f = self._brake_stream(b2, 0, 60, lambda i: True)                # 60 accepted echoes: the window closes
+    self.assertEqual(0, b2._probation_left)
+    self._brake_stream(b2, f, 40, lambda i: i % 3 == 0)
+    self.assertFalse(b2._refused_cut)
+
+  def test_probation_reopens_after_camera_release(self):
+    from opendbc.sunnypilot.car.hyundai.tests import fca11_cam_vectors as cv
+    b = self._brake()
+    f = self._brake_stream(b, 0, 60, lambda i: True)
+    self.assertEqual(0, b._probation_left)
+    f2 = f
+    self._step(b, cv.frame(CR_VSM_DecCmd=5), f2); f2 += 2
+    while b.cam_brake:
+      self._step(b, cv.frame(), f2); f2 += 2
+    self.assertEqual(fl.FCA11_PROBATION_ECHOES, b._probation_left, "a released hand-back opens probation")
+
+  def test_probation_does_not_false_trip_on_isolated_refusals(self):
+    b = self._brake()
+    self._brake_stream(b, 0, 60, lambda i: i not in (3, 17, 30, 44))  # 4 isolated refusals inside the window
+    self.assertFalse(b._refused_cut)
+
+  def test_consecutive_rule_unchanged(self):
+    b = self._brake()
+    f = self._brake_stream(b, 0, 60, lambda i: True)
+    self._brake_stream(b, f, 3 + 2, lambda i: i == 0)                 # 1 accepted (the echo of the last good frame), then refused
+    self.assertTrue(b._refused_cut)
+
+  # ---- divergence guard ----
+
+  def test_divergence_on_refused_passive_resyncs_then_latches_on_the_third(self):
+    """The panda refuses PASSIVE frames only while ITS cam_brake holds. Two refused passive echoes while Python sees no
+    camera brake: adopt the panda's view (cam_brake, alert), the third such event this ignition latches."""
+    from opendbc.sunnypilot.car.hyundai.tests import fca11_cam_vectors as cv
+    b = self._brake()
+    idle = cv.frame()
+    passive = b._passive_frame(_CS(cam=(0, idle)), 0)[0].dat
+    b.observe_echo([(128, bytes(passive))])                            # armed: the panda is taking our frames
+    for ev in range(1, 4):
+      b.observe_echo([(192, bytes(passive))])
+      self.assertFalse(b.fca11_divergence and ev == 1 and b._div_events == 0)
+      b.observe_echo([(192, bytes(passive))])
+      self.assertEqual(ev, b._div_events)
+      self.assertTrue(b.cam_brake, "resync: the stricter direction")
+      self._step(b, idle, 10 * ev)
+      self.assertTrue(b.fca11_divergence)
+      self.assertEqual(ev >= fl.FCA11_DIVERGENCE_LATCH_EVENTS, b._div_latched)
+      while b.cam_brake:
+        self._step(b, idle, 10 * ev + 2)
+      if ev < fl.FCA11_DIVERGENCE_LATCH_EVENTS:
+        self.assertFalse(b.fca11_divergence, "a resync clears with the hand-back it adopted")
+    self.assertEqual([], self._step(b, idle, 1000), "latched: no 0x38D for the rest of the ignition")
+    self.assertFalse(b.fca11_unavailable)
+
+  def test_refused_passive_while_camera_brakes_is_not_divergence(self):
+    from opendbc.sunnypilot.car.hyundai.tests import fca11_cam_vectors as cv
+    b = self._brake()
+    passive = b._passive_frame(_CS(cam=(0, cv.frame())), 0)[0].dat
+    b.observe_echo([(128, bytes(passive))])
+    b._cam_step(cv.frame(CR_VSM_DecCmd=3))
+    for _ in range(5):
+      b.observe_echo([(192, bytes(passive))])
+    self.assertEqual(0, b._div_events)
+
+  def test_divergence_not_armed_before_first_accepted_echo(self):
+    from opendbc.sunnypilot.car.hyundai.tests import fca11_cam_vectors as cv
+    b = self._brake()
+    passive = b._passive_frame(_CS(cam=(0, cv.frame())), 0)[0].dat
+    for _ in range(10):
+      b.observe_echo([(192, bytes(passive))])
+    self.assertEqual(0, b._div_events)
+
+  def test_wall_attribution_passive_accepted_keeps_the_cut(self):
+    """A refusal wall with no camera brake in sight: the episode ends for <= FCA11_ATTRIB_HOLD_FRAMES so the passive
+    close is judged. Accepted -> a real wall (cut stands, no divergence); braking resumes after the bounded hold."""
+    from opendbc.sunnypilot.car.hyundai.tests import fca11_cam_vectors as cv
+    b = self._brake()
+    f = self._brake_stream(b, 0, 60, lambda i: True)
+    got, echoes = [], []
+    for _ in range(12):
+      sends = self._step(b, cv.frame(), f, echoes=echoes); f += 2
+      got += sends
+      # the panda: every ACTUATING frame refused (a wall), every PASSIVE frame accepted (not the camera)
+      echoes = [(128 if fl.fca11_passive(bytes(x.dat)) else 192, bytes(x.dat)) for x in sends]
+    self.assertTrue(b._refused_cut)
+    passives = [i for i, x in enumerate(got) if fl.fca11_passive(bytes(x.dat))]
+    self.assertTrue(passives, "the passive close went out at the wall")
+    self.assertEqual(0, b._div_events, "an accepted passive frame proves it is not the camera")
+    self.assertTrue(any(fl._get_bits(x.dat, 8, 8) > 0 for x in got[passives[0] + 1:]), "braking is not wedged by the hold")
+
+  def test_wall_attribution_passive_refused_is_divergence(self):
+    """The same wall, but the panda ALSO refuses the passive close: only its cam_brake does that -> divergence, and the
+    refusals are re-attributed to the hand-back (no permanent unavailable)."""
+    from opendbc.sunnypilot.car.hyundai.tests import fca11_cam_vectors as cv
+    b = self._brake()
+    f = self._brake_stream(b, 0, 60, lambda i: True)
+    echoes = []
+    for _ in range(12):
+      sends = self._step(b, cv.frame(), f, echoes=echoes); f += 2
+      echoes = [(192, bytes(x.dat)) for x in sends]
+    self.assertEqual(1, b._div_events)
+    self.assertTrue(b.cam_brake and b.fca11_divergence)
+    self.assertFalse(b._refused_cut, "re-attributed to the camera hand-back")
+    self.assertFalse(b.fca11_unavailable)
