+    self.assertEqual(cam_vectors.field_mask(cam_vectors.BRAKING_FIELDS), HYUNDAI_FCA11_CAM_BRAKE_MASK)
+    self.assertEqual(cam_vectors.field_mask(cam_vectors.WARNING_FIELDS), HYUNDAI_FCA11_CAM_WARN_MASK)
+    self.assertEqual(0, HYUNDAI_FCA11_CAM_BRAKE_MASK & HYUNDAI_FCA11_CAM_WARN_MASK)
+    self.assertEqual(75, HYUNDAI_FCA11_CAM_QUIET_FRAMES)
