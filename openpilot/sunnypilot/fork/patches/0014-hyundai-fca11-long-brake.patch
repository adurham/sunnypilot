+      self.assertEqual([], b.update(self._cc(-2.0), _CS(state=st, cam=_cam()), 0), st)
+    for st in (0, 4, 5):
+      b = self._brake(self._cp_sp())
+      self.assertNotEqual([], b.update(self._cc(-2.0), _CS(state=st, cam=_cam()), 0), st)
+
+  def test_alert_gate(self):
+    b = self._brake(self._cp_sp())
+    b.update(self._cc(-0.2), _CS(v_ego=13.0 / 3.6, cam=_cam(), lead_closing=True), 0)
+    self.assertTrue(b.low_speed_alert)
+    b.update(self._cc(-0.2), _CS(v_ego=20.0 / 3.6, cam=_cam(), lead_closing=True), 0)
