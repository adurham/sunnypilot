+  def test_no_send_below_floor(self):
+    b = self._brake(self._cp_sp())
+    sends = b.update(self._cc(-2.0), _CS(v_ego=fl.FCA11_BRAKE_MIN_KPH / 3.6 - 0.01, cam=_cam()), 0)
+    self.assertEqual([], sends)
+    self.assertFalse(b.braking)
