+  def test_send_rate_every_other_frame(self):
+    b = self._brake(self._cp_sp())
+    s0 = b.update(self._cc(-2.0), _CS(cam=_cam()), 0)
+    s1 = b.update(self._cc(-2.0), _CS(cam=_cam()), 1)
+    self.assertEqual(1, len(s0))
+    self.assertEqual(0, len(s1))
