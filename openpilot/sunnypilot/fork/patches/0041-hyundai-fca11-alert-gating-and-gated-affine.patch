+      # the floor the law wants is reached by the 2nd frame either way (hold 8 / release 4); a moving ask stays at 4
+      want = fl.FCA11_AFFINE_HOLD_LSB if in_hold else fl.FCA11_AFFINE_RELEASE_LSB
