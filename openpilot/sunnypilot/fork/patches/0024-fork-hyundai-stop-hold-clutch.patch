+class TestStopHold(unittest.TestCase):
+  """2026-11-03 (route 190): at a standstill the driver's pedal leaves Clutch_Driving_Tq at 0.0 Nm while our FCA11 hold
+  leaves it at +26 Nm, so the clutch follows the PEDAL-side signal, not the caliper. While the dynamic-brakes instance is
+  holding the car at a stop, the mirror asks for the ESC's own stop hold (FCA_StopReq + CF_VSM_HBACmd); every other frame
+  mirrors the camera byte-for-byte, and the deployed law never sets either field."""
+
+  CAM = bytes.fromhex("0000030000000000")
+
+  def _law(self, dynamic=True):
+    b = object.__new__(fl.Fca11LongBrake)
+    b.dynamic_brakes = dynamic
+    return b
+
+  def test_frame_sets_stopreq_and_hba_only_when_asked(self):
+    f = fl.build_fca11_frame(self.CAM, 3, fl.Fca11MirrorFrame(dec_cmd=20, prefill=True, warn=3,
+                                                             cmd_act=True, dec_cmd_act=False, stop_hold=True))
+    self.assertEqual(1, (f[2] >> 5) & 0x1, "FCA_StopReq is bit 21")
+    self.assertEqual(1, (f[0] >> 1) & 0x3, "CF_VSM_HBACmd is bits 1-2")
+
+  def test_mirroring_the_camera_is_unchanged(self):
+    a = fl.build_fca11_frame(self.CAM, 3, fl.Fca11MirrorFrame(dec_cmd=20, prefill=True, warn=3,
+                                                             cmd_act=True, dec_cmd_act=False))
+    b = fl.build_fca11_frame(self.CAM, 3, fl.Fca11MirrorFrame(dec_cmd=20, prefill=True, warn=3,
+                                                             cmd_act=True, dec_cmd_act=False, stop_hold=False))
+    self.assertEqual(a, b, "None/False must both mirror the camera byte-for-byte")
+
+  def test_only_the_dynamic_instance_asks(self):
+    self.assertIsNone(self._law(False)._stop_hold_request(0.0, 30), "deployed law never sets the fields")
+    self.assertTrue(self._law(True)._stop_hold_request(0.0, 20), "holding at a stop -> ask")
+    self.assertTrue(self._law(True)._stop_hold_request(1.5, 7), "armed up to the stop band at the clutch-open level")
+
+  def test_it_never_asks_while_moving_or_light(self):
+    law = self._law(True)
+    self.assertIsNone(law._stop_hold_request(2.5, 20), "above the stop band")
+    self.assertIsNone(law._stop_hold_request(0.0, 4), "not holding hard enough to be a stop")
