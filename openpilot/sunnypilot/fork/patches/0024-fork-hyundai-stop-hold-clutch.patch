@@ -4440,3 +4440,117 @@
     self.assertEqual(30, fl.personality_max_dec(fl.PERSONALITY_AGGRESSIVE))
     self.assertEqual(30, fl.fca11_standstill_hold_lsb())
     self.assertLessEqual(max(fl.PERSONALITY_MAX_DEC.values()), fl.FCA11_MEAS_CEIL_LSB)
+
+def _stop_and_hold_scenario(f):
+  """(ask m/s^2, vEgo m/s, standstill) for one 100 Hz frame of a full stop: cruise at 20 km/h, a firm stop to 0 over
+  ~3 s, a 6 s hold at a red light (the regime the removed stop-hold lane targeted: <= 2 km/h and >= 7 LSB), then the
+  launch (ask released, car rolls away)."""
+  if f < 50:
+    return -0.2, 20.0 / 3.6, False
+  if f < 350:
+    v = max(0.0, 20.0 / 3.6 * (1.0 - (f - 50) / 300.0))
+    return -2.0, v, v == 0.0
+  if f < 950:
+    return -2.0, 0.0, True
+  return 0.5, min(3.0, (f - 950) * 0.02), False
+
+
+def stop_and_hold_frames(dynamic, cam_dat):
+  """Run the law through _stop_and_hold_scenario with the given camera frame; returns [(frame, dat)] for every 0x38D sent."""
+  b = fl.Fca11LongBrake(structs.CarParams(), _cp_sp(dyn=dynamic))
+  out = []
+  for f in range(1100):
+    ask, v, ss = _stop_and_hold_scenario(f)
+    for s in b.update(_cc(ask), _CS(v_ego=v, cam=(0, cam_dat), standstill=ss, a_ego=-1.5 if ask < 0 else 0.3), f):
+      if s.address == fl.FCA11_ADDR:
+        out.append((f, bytes(s.dat)))
+  return out
+
+
+class TestNoStopHoldBits(unittest.TestCase):
+  """2026-11-03: the stop-hold lane (patch 0024: FCA_StopReq 21|1 + CF_VSM_HBACmd 1|2 while holding at a stop) was
+  REMOVED - the panda's production TX hook (safety/modes/hyundai.h) refuses any host 0x38D with either set, so the lane
+  never actuated. These fields are now never ours: every frame the law sends carries exactly the camera's value
+  (the camera is idle -> 0), across a full stop-and-hold, with Dynamic Brakes OFF and ON."""
+
+  CAM = _real_camera_frame(alive=3)
+
+  def test_lane_is_gone(self):
+    for name in ("FCA11_STOP_HOLD_V_KPH", "FCA11_STOP_HOLD_MIN_LSB"):
+      self.assertFalse(hasattr(fl, name), name)
+    self.assertFalse(hasattr(fl.Fca11LongBrake, "_stop_hold_request"))
+    self.assertNotIn("stop_hold", fl.Fca11MirrorFrame.__dataclass_fields__)
+
+  def test_full_stop_and_hold_never_sets_stopreq_or_hba(self):
+    cam_stop, cam_hba = fl._get_bits(self.CAM, 21, 1), fl._get_bits(self.CAM, 1, 2)
+    for dynamic in (False, True):
+      with self.subTest(dynamic=dynamic):
+        sent = stop_and_hold_frames(dynamic, self.CAM)
+        held = [(f, d) for f, d in sent if f >= 400 and fl._get_bits(d, 8, 8) >= 7]
+        # the scenario must actually reach the regime the removed lane fired in (standstill, >= 7 LSB), for seconds
+        self.assertGreater(len(held), 200, f"never held at a stop (dynamic={dynamic})")
+        self.assertTrue(any(fl._get_bits(d, 8, 8) == 0 for f, d in sent if f >= 950), "the launch closes the episode")
+        for f, d in sent:
+          self.assertEqual(cam_stop, fl._get_bits(d, 21, 1), f"FCA_StopReq @frame {f} (dynamic={dynamic})")
+          self.assertEqual(cam_hba, fl._get_bits(d, 1, 2), f"CF_VSM_HBACmd @frame {f} (dynamic={dynamic})")
+
+  def test_builder_copies_the_camera_fields_verbatim(self):
+    """build_fca11_frame never writes bits 1-2 or 21: whatever the camera carries is what goes out (here: both set,
+    a shape the panda would hand back on anyway - this pins the builder, not a reachable state)."""
+    m = fl.Fca11MirrorFrame(dec_cmd=20, prefill=True, warn=3, cmd_act=True, dec_cmd_act=False)
+    for hba, stop in ((0, 0), (1, 0), (2, 1), (3, 1)):
+      cam = _real_camera_frame(alive=3, hba=hba, stop_req=stop)
+      out = fl.build_fca11_frame(cam, 4, m)
+      self.assertEqual(hba, fl._get_bits(out, 1, 2))
+      self.assertEqual(stop, fl._get_bits(out, 21, 1))
+
+class TestNoStopHoldBitsPandaTx(unittest.TestCase):
+  """The same stop-and-hold stream through the REAL panda production TX hook (libsafety, HyundaiSafetyFlagsSP.FCA11_LONG
+  on the pedal car, window open, engaged). The claim is scoped to the removed lane's fields: forcing FCA_StopReq and
+  CF_VSM_HBACmd to 0 never changes a single verdict, i.e. those bits never cost the law a frame. (Other fields are
+  judged by the panda as they are; this test does not mask them.)"""
+
+  def _fixture(self):
+    import opendbc.safety.tests.test_hyundai as th
+    tc = th.TestHyundaiFca11LongSafety_0("test_needs_controls_and_heartbeat")
+    tc.setUp()
+    return tc
+
+  @staticmethod
+  def _without_lane_bits(d):
+    b = bytearray(d)
+    b[0] &= 0xF9          # CF_VSM_HBACmd (1|2) -> 0
+    b[2] &= 0xDF          # FCA_StopReq (21|1) -> 0
+    b[7] = hyundai_checksum(bytes(b[:7]))
+    return bytes(b)
+
+  def _verdicts(self, tc, sent, transform):
+    from opendbc.safety.tests.libsafety import libsafety_py
+    tc._rearm()
+    out = []
+    for f, d in sent:
+      tc.safety.set_timer(1_000_000 + f * 10_000)
+      tc._open_window(speed_raw=0 if f >= 350 else 640)
+      tc._rx(tc._cam_fca11())
+      out.append(tc._tx(libsafety_py.make_CANPacket(fl.FCA11_ADDR, 0, transform(d))))
+    return out
+
+  def test_stopreq_and_hba_never_cost_a_frame(self):
+    tc = self._fixture()
+    cam = _real_camera_frame(alive=3)
+    for dynamic in (False, True):
+      with self.subTest(dynamic=dynamic):
+        sent = stop_and_hold_frames(dynamic, cam)
+        self.assertGreater(len(sent), 400)
+        as_sent = self._verdicts(tc, sent, lambda d: d)
+        cleaned = self._verdicts(tc, sent, self._without_lane_bits)
+        self.assertEqual(cleaned, as_sent, "FCA_StopReq / CF_VSM_HBACmd changed a panda verdict")
+        # falsifiable contrast on a frame the panda ACCEPTS (the law's own passive close at the launch): with either of
+        # the removed lane's bits set, the same frame is refused - which is why the lane never actuated.
+        f, d = next((f, d) for f, d in sent if f >= 950 and fl._get_bits(d, 8, 8) == 0)
+        self.assertEqual([True], self._verdicts(tc, [(f, d)], lambda x: x))
+        for byte, mask, name in ((2, 0x20, "FCA_StopReq"), (0, 0x02, "CF_VSM_HBACmd")):
+          lane = bytearray(d)
+          lane[byte] |= mask
+          lane[7] = hyundai_checksum(bytes(lane[:7]))
+          self.assertEqual([False], self._verdicts(tc, [(f, bytes(lane))], lambda x: x), name)
