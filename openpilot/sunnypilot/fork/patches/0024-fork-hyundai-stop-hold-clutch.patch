+  def _stop_hold_request(self, v_kph: float, dec_cmd: int) -> bool | None:
+    """The FCA_StopReq / HBA request for this frame, or None to mirror the camera.
+
+    Only the dynamic-brakes (V3 core) instance may ask, and only while it is holding the car at a stop; every other frame
+    mirrors the camera byte-for-byte, so the deployed-law stream is untouched.
+    """
+    if not getattr(self, "dynamic_brakes", False):
+      return None
+    try:
+      holding = float(v_kph) <= FCA11_STOP_HOLD_V_KPH and int(dec_cmd) >= FCA11_STOP_HOLD_MIN_LSB
+    except (TypeError, ValueError):
+      return None
+    return True if holding else None
