--- a/opendbc/sunnypilot/car/hyundai/fca11_long.py
+++ b/opendbc/sunnypilot/car/hyundai/fca11_long.py
@@ -869,6 +869,15 @@
 # 7 LSB reads -20.0 Nm, the same as every level above it, i.e. the clutch is unambiguously open and the creep torque is
 # gone. 6 is the boundary, not yet open; one more LSB costs ~+0.1 m/s^2 of commanded brake at crawl.
 FCA11_CRAWL_MIN_LSB = 7                   # LSB: first level with an unambiguously OPEN clutch (-20 Nm, creep torque gone)
+
+# *** 2026-11-03 (route 190): the clutch at a stop - NOT reachable through FCA11 ***
+# MEASURED: at a standstill the driver's pedal puts Clutch_Driving_Tq (0x162) at 0.0 Nm while our FCA11 hold leaves it at
+# +26 Nm (creep torque live): the pressure the ESC builds from CR_VSM_DecCmd is injected downstream of the master-cylinder
+# sensor, so the transmission never learns the car is held. The only FCA11 levers that could ask the ESC for its OWN stop
+# hold are FCA_StopReq (21|1) and CF_VSM_HBACmd (1|2), and the panda's production TX hook (safety/modes/hyundai.h) refuses
+# any host 0x38D with either set. A lane that set them (patch 0024) never actuated and has been REMOVED; panda safety is
+# deliberately not relaxed. build_fca11_frame copies both fields from the camera (always 0 here), so they are never ours.
+
 FCA11_CRAWL_RELEASE_HOLDOFF_S = 0.5       # s: a crawl release stays a release (no re-application chatter at 6-7 LSB)
 FCA11_CRAWL_RELEASE_HOLDOFF_FRAMES = 50   # controller frames at 100 Hz
 
