+        def cs_fn(f, v=v):
+          return _CS(v_ego=v, cam=_cam(), standstill=(v == 0.0))
+        self.assertEqual(_run(_brake(False), asks, cs_fn=cs_fn), _run(_brake(True), asks, cs_fn=cs_fn), v)
+
