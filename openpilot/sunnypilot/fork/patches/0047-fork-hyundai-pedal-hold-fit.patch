+def _wire_pedal(w):
+  """0x700/0x200 command bytes -> the commanded pedal fraction (the encoding replay_real/lawsim decode)."""
+  if w is None:
+    return np.nan
+  raw = (w[0] << 8) | w[1]
+  return (raw * 0.11855 - 55.126) / 255. if raw > 0 else 0.
