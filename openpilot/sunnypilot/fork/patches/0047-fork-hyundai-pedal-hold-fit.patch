+      dw = (wb - wa) * 255. if (np.isfinite(wa) and np.isfinite(wb)) else 0.
+      res["worst_wire_lsb"] = max(res["worst_wire_lsb"], dw)
+      if dw > tol_lsb:
+        res["n_wire"] += 1
+  return res
