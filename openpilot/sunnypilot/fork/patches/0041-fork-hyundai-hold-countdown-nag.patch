+  def test_f_the_nag_changes_no_wire_byte(self):
+    """Golden stream: the same 240 s hold run twice through the REAL class, once with the escalation neutralised
+    (hold_nag_level pinned to 0). Every 0x38D byte and every frame number must be identical, and the level must not
+    move across the 120 s / 180 s boundaries in the normal run."""
+    real = fl.hold_nag_level
+    try:
+      normal = _hold(fl.Fca11LongBrake(structs.CarParams(), _cp_sp()), int(240 * 100))
+      fl.hold_nag_level = lambda _frames: 0
+      neutral = _hold(fl.Fca11LongBrake(structs.CarParams(), _cp_sp()), int(240 * 100))
+    finally:
+      fl.hold_nag_level = real
+    self.assertEqual(_wire(normal), _wire(neutral))
+    self.assertEqual({SOFT, LOUD}, {nag for _f, _s, nag in normal} - {NONE})
