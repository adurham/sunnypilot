diff --git a/opendbc/sunnypilot/car/hyundai/tests/test_fca11_hold_nag.py b/opendbc/sunnypilot/car/hyundai/tests/test_fca11_hold_nag.py
new file mode 100644
--- /dev/null
+++ b/opendbc/sunnypilot/car/hyundai/tests/test_fca11_hold_nag.py
@@ -0,0 +1,207 @@
+"""
+0041: the standstill HOLD COUNTDOWN + escalating driver nag (fca11_long.py).
+
+The clutch cannot be opened without the driver's foot, so a standstill hold is openpilot holding the car with ESC
+pressure and a live clutch torque. It is bounded by an ALERT, never by a release: after FCA11_HOLD_NAG_SOFT_S the
+driver is told to put a foot on the brake, after FCA11_HOLD_NAG_LOUD_S the nag is loud and re-chimes every
+FCA11_HOLD_NAG_REPEAT_S, and THE HOLD STAYS ON THE WIRE. A released hold in D lets the car creep or roll.
+
+Every stream test here drives the REAL controller (Fca11LongBrake.update) with a CarState double, exactly as the
+stop-hold lane's tests do, and reads the state the superproject publishes (CarStateSP.holdNag) plus the level that
+actually went out on the wire.
+"""
+import unittest
+
+from opendbc.car import structs
+from opendbc.sunnypilot.car.hyundai import fca11_long as fl
+from opendbc.sunnypilot.car.hyundai.tests.test_fca11_long import _CS, _cc, _real_camera_frame
+
+CAM = _real_camera_frame(alive=3)
+NONE, SOFT, LOUD = (int(getattr(fl, "FCA11_HOLD_NAG_NONE", 0)), int(getattr(fl, "FCA11_HOLD_NAG_SOFT", 1)),
+                     int(getattr(fl, "FCA11_HOLD_NAG_LOUD", 2)))
+# SENT frames per second is the counting unit: 100 Hz controller / FCA11_SEND_EVERY == 2.
+SENT_PER_S = float(getattr(fl, "FCA11_HOLD_NAG_SENT_HZ", 50.0))
+
+
+def _cp_sp(fca11=True):
+  cp_sp = structs.CarParamsSP()
+  cp_sp.fca11Brake = fca11
+  cp_sp.enableGasInterceptor = True
+  return cp_sp
+
+
+def _hold(brake, n, ask=-2.0, v=0.0, standstill=True, brake_pressed=False, gear=None, start=0, record=None):
+  """Run n controller frames of a steady standstill hold. Returns [(frame, wire level, hold_nag)] for SENT frames.
+
+  `ask` is the planner ask; at a standstill a gentle ask (-0.30) holds ~8 LSB (the band floor) and a firm one (-2.0)
+  holds 30 LSB, which is the regime the countdown is about. The camera is fresh on every frame.
+  """
+  if record is None:
+    record = []
+  for f in range(start, start + n):
+    cs = _CS(v_ego=v, cam=(0, CAM), standstill=standstill, a_ego=-1.5 if ask < 0 else 0.3,
+              brake=brake_pressed, gear=gear or structs.CarState.GearShifter.drive)
+    cs.fca11_wheel_max_kph = v * 3.6
+    sends = brake.update(_cc(ask), cs, f)
+    if record is not None:
+      # getattr: on the pre-0041 tree the state does not exist, and the behavioural tests must then fail on the VALUE
+      # (it never nags) rather than on an AttributeError - the same standard lane V was reviewed against.
+      record.append((f, sends, int(getattr(brake, "hold_nag", NONE))))
+  return record
+
+
+def _wire(record):
+  """[(frame, bytes)] of every 0x38D actually sent, in order."""
+  out = []
+  for f, sends, _nag in record:
+    out.extend((f, bytes(s.dat)) for s in sends if s.address == fl.FCA11_ADDR)
+  return out
+
+
+def _levels(record):
+  return [(f, fl._get_bits(dat, 8, 8)) for f, dat in _wire(record)]
+
+
+def _first_nag(record, want):
+  for f, _sends, nag in record:
+    if nag == want:
+      return f
+  return None
+
+
+class TestCountdownShape(unittest.TestCase):
+  """The pure escalation: X1 soft, X2 loud, then a 3 s loud pulse at the head of every 30 s period."""
+
+  def test_named_constants(self):
+    self.assertEqual(120.0, fl.FCA11_HOLD_NAG_SOFT_S)
+    self.assertEqual(180.0, fl.FCA11_HOLD_NAG_LOUD_S)
+    self.assertEqual(30.0, fl.FCA11_HOLD_NAG_REPEAT_S)
+    self.assertEqual(20, fl.FCA11_HOLD_NAG_MIN_LSB)
+    self.assertEqual((NONE, SOFT, LOUD), (0, 1, 2))
+
+  def test_soft_then_loud_then_repeat(self):
+    f = lambda s: int(round(s * SENT_PER_S))     # noqa: E731
+    self.assertEqual(NONE, fl.hold_nag_level(0))
+    self.assertEqual(NONE, fl.hold_nag_level(f(119.98)))
+    self.assertEqual(SOFT, fl.hold_nag_level(f(120.0)))
+    self.assertEqual(SOFT, fl.hold_nag_level(f(179.98)))
+    self.assertEqual(LOUD, fl.hold_nag_level(f(180.0)))
+    self.assertEqual(LOUD, fl.hold_nag_level(f(182.9)))
+    self.assertEqual(SOFT, fl.hold_nag_level(f(183.1)))      # the banner stays up, the chime stops
+    self.assertEqual(SOFT, fl.hold_nag_level(f(209.9)))
+    self.assertEqual(LOUD, fl.hold_nag_level(f(210.0)))      # next repeat period
+    self.assertEqual(SOFT, fl.hold_nag_level(f(213.1)))
+    self.assertEqual(LOUD, fl.hold_nag_level(f(240.0)))
+    self.assertEqual(NONE, fl.hold_nag_level(-5))             # never negative
+
+
+class TestCounterOnTheRealClass(unittest.TestCase):
+  """The counter is armed by the SENT level, reset by anything that ends the hold, and never touches the wire."""
+
+  def test_a_the_lsb_arming_gate_is_what_starts_the_clock(self):
+    """The SAME 210 s standstill hold never nags when the arming level is above what the law sends, and nags when it is
+    at or below it: the clock is armed by the SENT level, not by "we are stopped"."""
+    real = fl.FCA11_HOLD_NAG_MIN_LSB
+    try:
+      fl.FCA11_HOLD_NAG_MIN_LSB = 31          # one LSB above the 30 LSB ceiling the wire allows
+      rec = _hold(fl.Fca11LongBrake(structs.CarParams(), _cp_sp()), int(210 * 100))
+      levels = [lv for _f, lv in _levels(rec)]
+      self.assertTrue(levels, "the law must still be holding")
+      self.assertEqual(30, max(levels))
+      self.assertEqual({NONE}, {nag for _f, _s, nag in rec})
+
+      fl.FCA11_HOLD_NAG_MIN_LSB = 30          # the level it actually sends
+      rec2 = _hold(fl.Fca11LongBrake(structs.CarParams(), _cp_sp()), int(121 * 100))
+      self.assertEqual(SOFT, rec2[-1][2])
+    finally:
+      fl.FCA11_HOLD_NAG_MIN_LSB = real
+
+  def test_b_a_firm_standstill_hold_nags_soft_at_120_s_and_loud_at_180_s(self):
+    """The real class, 240 s at 30 LSB: soft on the 6000th sent frame (120.00 s), loud on the 9000th (180.00 s),
+    loud again at 210 s and 240 s - and it is the SENT count, not a wall clock (the frames are fed in a tight loop)."""
+    rec = _hold(fl.Fca11LongBrake(structs.CarParams(), _cp_sp()), int(240 * 100))
+    levels = [lv for _f, lv in _levels(rec)]
+    self.assertGreaterEqual(max(levels), 20)
+    f_soft = _first_nag(rec, SOFT)
+    f_loud = _first_nag(rec, LOUD)
+    self.assertIsNotNone(f_soft)
+    self.assertIsNotNone(f_loud)
+    # the FIRST soft frame is the first SENT frame at >= 120 s of >= 20 LSB hold: the 6000th such frame has just gone out
+    armed = [(f, lv) for f, lv in _levels(rec) if lv >= fl.FCA11_HOLD_NAG_MIN_LSB]
+    self.assertEqual(6000, sum(1 for f, _lv in armed if f <= f_soft))
+    self.assertEqual(9000, sum(1 for f, _lv in armed if f <= f_loud))
+    louds = [nag for _f, _s, nag in rec if nag == LOUD]
+    self.assertGreaterEqual(len(louds), 3)
+
+  def test_c_motion_ends_the_standstill_and_resets_the_countdown(self):
+    """121 s of hold (nag up), then the car MOVES: the nag drops and the clock restarts from zero, so a further 119 s
+    of hold does not nag. This is the reset, not a pause."""
+    brake = fl.Fca11LongBrake(structs.CarParams(), _cp_sp())
+    rec = _hold(brake, int(121 * 100))
+    self.assertEqual(SOFT, rec[-1][2])
+    moving = [f for f in range(12100, 12140)]
+    for f in moving:
+      cs = _CS(v_ego=2.0, cam=(0, CAM), standstill=False, a_ego=-1.0)
+      cs.fca11_wheel_max_kph = 7.2
+      brake.update(_cc(-0.31), cs, f)
+    self.assertEqual(NONE, int(getattr(brake, "hold_nag", NONE)))
+    self.assertEqual(0, int(getattr(brake, "_nag_frames", 0)))
+    # and the next 119 s of the SAME episode cannot reach the soft threshold
+    rec2 = _hold(brake, int(119 * 100), start=12200)
+    self.assertEqual({NONE}, {nag for _f, _s, nag in rec2})
+
+  def test_d_the_driver_brake_takes_over_and_resets_the_countdown(self):
+    """The nag exists to hand the hold to the driver's foot: brakePressed drops it on the same frame and starts a new
+    countdown, so a later hold must run its own full 120 s."""
+    brake = fl.Fca11LongBrake(structs.CarParams(), _cp_sp())
+    rec = _hold(brake, int(121 * 100))
+    self.assertEqual(SOFT, rec[-1][2])
+    rec_b = _hold(brake, 10, brake_pressed=True, start=12100)
+    self.assertEqual({NONE}, {nag for _f, _s, nag in rec_b})
+    self.assertEqual(0, int(getattr(brake, "_nag_frames", 0)))
+    rec2 = _hold(brake, int(119.5 * 100), start=12110)
+    self.assertEqual({NONE}, {nag for _f, _s, nag in rec2})
+
+  def test_e_expiry_never_releases_the_hold(self):
+    """THE hard rule: at 120 s, at 180 s and 60 s after that the level on the wire is still the full hold. A released
+    hold in D lets the car creep; only the driver's brake / gear / disengage may end it."""
+    rec = _hold(fl.Fca11LongBrake(structs.CarParams(), _cp_sp()), int(245 * 100))
+    by_t = {}
+    sent = 0
+    for f, sends, _nag in rec:
+      for s in sends:
+        if s.address == fl.FCA11_ADDR:
+          sent += 1
+          by_t[sent] = fl._get_bits(s.dat, 8, 8)
+    self.assertGreater(sent, 9000)
+    for t_s in (119.9, 120.0, 130.0, 179.9, 180.0, 200.0, 240.0):
+      idx = int(round(t_s * SENT_PER_S))
+      self.assertEqual(30, by_t[idx], f"level at {t_s} s")
+    # and the law is still SENDING at the end (not a silent stop): the last 100 frames carry a level
+    self.assertEqual(30, by_t[sent])
