diff --git a/opendbc/car/hyundai/carstate.py b/opendbc/car/hyundai/carstate.py
index a35a504..5da3afa 100644
--- a/opendbc/car/hyundai/carstate.py
+++ b/opendbc/car/hyundai/carstate.py
@@ -357,7 +357,12 @@ class CarState(CarStateBase, EsccCarStateBase, MadsCarState, CarStateExt):
       # reads frames per tick; nothing polls it at 100 Hz). CANParser builds message_states ONLY from this
       # `messages` list, so before this subscription CLU13 was never decoded: CarStateSP.driveMode stayed 0,
       # making DriveModePersonality inert AND killing the N/N-Custom longitudinal block (patch 0021).
-      Bus.pt: CANParser(DBC[CP.carFingerprint][Bus.pt], [(DRIVE_MODE_MSG, 10)], 0),
+      # 0048: subscribe the KDMLink-derived telemetry messages (folded into the DBC by patch 0046) at
+      # their own bus rates (measured on the owner's routes) so the parser tracks validity for them;
+      # CarStateExt.update_telemetry reads them off this parser every frame. Legacy-CAN only (the CAN-FD
+      # path never sees these messages and leaves the fields at 0).
+      Bus.pt: CANParser(DBC[CP.carFingerprint][Bus.pt], [(DRIVE_MODE_MSG, 10), ("EMS_453", 100), ("ESP_49D", 10),
+                                                         ("BATT_568", 20), ("N_MODE_4A0", 20)], 0),
       Bus.cam: CANParser(DBC[CP.carFingerprint][Bus.pt], [], 2),
     }
     if CP_SP.enableGasInterceptor:
diff --git a/opendbc/car/structs.py b/opendbc/car/structs.py
index cb5bf23..4cef9ef 100644
--- a/opendbc/car/structs.py
+++ b/opendbc/car/structs.py
@@ -199,3 +199,19 @@ class CarStateSP:
   # decode; see sunnypilot/car/hyundai/fuel_level.py); 0.0 = not decoded / no valid frame yet.
   # Coupled with custom.capnp CarStateSP.
   fuelLevel: float = auto_field()
+  # 0048: KDMLink-derived telemetry (messages folded into the DBC by patch 0046). Every value is the
+  # last one seen off the C-CAN parser; the parser holds it across gaps. 0.0 = not decoded / no frame
+  # yet unless stated. Coupled with custom.capnp CarStateSP.
+  intakeTemp: float = auto_field()      # EMS_453 D2 (degC, x0.75 - 48); ~ambient + 10 when driving
+  lateralAccel: float = auto_field()    # ESP_49D (g, 16-bit centered); 0.0 is a real value (straight)
+  longAccel: float = auto_field()       # ESP_49D (g, 12-bit; the Elantra N new-gateway layout)
+  batteryVoltage: float = auto_field()  # BATT_568 D3 (V, x0.1; the newer gateway)
+  # N_MODE_4A0: the N-Custom settings block. Per-setting: 0/1/2 = the normal|sport|sport+ style steps,
+  # 3 = unset/default. All zero while the car is in NORMAL drive mode; live in SPORT / N (routes).
+  nModeEngine: int = auto_field()       # 0 Normal / 1 Sport / 2 Sport+
+  nModeSuspension: int = auto_field()   # 0 Comfort / 1 Normal / 2 Sport
+  nModeEsc: int = auto_field()          # 0 On / 1 Sport / 2 Off
+  nModeExhaust: int = auto_field()      # 0 Quiet / 1 Normal / 2 Sport+
+  nModeRevMatch: int = auto_field()     # 0 off / 1 on
+  nModeELSD: int = auto_field()         # 0 Normal / 1 Sport / 2 Sport+
+  nModeSteering: int = auto_field()     # 0 Comfort / 1 Normal / 2 Sport
diff --git a/opendbc/sunnypilot/car/hyundai/carstate_ext.py b/opendbc/sunnypilot/car/hyundai/carstate_ext.py
