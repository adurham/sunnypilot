+    with tempfile.TemporaryDirectory() as d:
+      _write_plan(d, _cal_plan([(60, 20)]))
+      # band wrong: cruising at 40 km/h, plan wants 60 -> band_not_ready
+      b = self._brake(self._cp_sp(), d)
