+      _write_plan(d, _cal_plan([(60, 20)], cond={"straight_min_s": 2.0}))
+      self._warm(b, _CalCS(cam=_cam(), yaw=0.05, v_ego=16.67))  # a_lat = 0.83 > 0.5
