-  hyundai_fca11_long_ts_act = 0U;
-  hyundai_fca11_long_ts_act_end = 0U;
   hyundai_fca11_long_dec_last = -1;
 }
 
@@ -965,15 +964,14 @@ static bool hyundai_tx_hook(const CANPacket_t *msg) {
