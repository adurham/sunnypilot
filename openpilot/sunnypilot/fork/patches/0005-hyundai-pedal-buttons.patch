+    CI = CarInterface(CP, CP_SP)
+    t, types = 0, []
+    for btn in [0] * 5 + [4] * 5 + [0] * 10:
+      t += 10_000_000
+      ret, _ = CI.update([(t, [PK.make_can_msg("CLU11", 0, {"CF_Clu_CruiseSwState": btn})])])
