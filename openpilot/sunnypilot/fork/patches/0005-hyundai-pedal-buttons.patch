diff --git a/opendbc/safety/modes/hyundai_common.h b/opendbc/safety/modes/hyundai_common.h
index 4013819f..30b73e68 100644
--- a/opendbc/safety/modes/hyundai_common.h
+++ b/opendbc/safety/modes/hyundai_common.h
@@ -84,6 +84,23 @@ bool hyundai_gas_interceptor_remapped = false;
 extern bool hyundai_fca11_brake_test;
 bool hyundai_fca11_brake_test = false;
 
+// Gas interceptor only: factory (conventional) cruise MAIN armed, EMS16 CRUISE_LAMP_M. The factory cruise can only engage
+// while MAIN is armed, and openpilot never sends CLU11 in this mode (no CANCEL to fight it), so pedal-long is locked out
+// while it is armed: controls_allowed is cleared and no button may grant it (fail closed, never two speed controllers).
+extern bool hyundai_factory_main_on;
+bool hyundai_factory_main_on = false;
+
+// Gas interceptor only: the steering-wheel pause/resume button (CLU11 CF_Clu_CruiseSwState 4, "CANCEL" in the DBC).
+// A press while longitudinal is engaged disengages (as before). A press while disengaged re-engages, but ONLY when the
+// press started with brake and gas released, neither was pressed at any time during the press, and the button was then
+// released for HYUNDAI_PAUSE_RELEASE_SAMPLES consecutive NONE samples (debounce: a one-frame bounce inside a disengage
+// press must never turn it into a resume). Nothing else re-grants controls: no timer, brake release or speed recovery.
+// MUST equal PAUSE_RELEASE_SAMPLES in opendbc/sunnypilot/car/hyundai/pause_resume.py (a unit test enforces this).
+#define HYUNDAI_PAUSE_RELEASE_SAMPLES 3U  // CLU11 is 50 Hz: 60 ms
+static bool hyundai_setres_brake_seen;       // gas interceptor: brake was pressed during the current SET/RES press
+static bool hyundai_pause_armed;             // the current/last press will resume on its debounced release
+static uint8_t hyundai_pause_released_cnt;   // consecutive NONE samples since the button was last 4
+
 static uint8_t hyundai_last_button_interaction;  // button messages since the user pressed an enable button
 
 static bool main_button_prev;
@@ -116,6 +133,10 @@ void hyundai_common_init(uint16_t param) {
   hyundai_last_button_interaction = HYUNDAI_PREV_BUTTON_SAMPLES;
 
   main_button_prev = false;
+  hyundai_factory_main_on = false;
+  hyundai_pause_armed = false;
+  hyundai_setres_brake_seen = false;
+  hyundai_pause_released_cnt = HYUNDAI_PAUSE_RELEASE_SAMPLES;
   acc_main_on_prev = false;
   acc_main_on_tx = false;
   acc_main_on_mismatches = 0U;
@@ -161,13 +182,55 @@ void hyundai_common_cruise_state_check(const bool cruise_engaged) {
     }
     cruise_engaged_prev = cruise_engaged;
   } else if (hyundai_gas_interceptor) {
-    // Pressing SET/RES on a non-SCC car also engages the factory (non-adaptive) cruise, which would hold speed while
-    // openpilot coasts. Track its state only so openpilot may send CANCEL (hyundai_tx_hook); never grants controls.
+    // The factory (non-adaptive) cruise never grants controls here; it is locked out via its MAIN lamp instead
+    // (hyundai_factory_main_on, hyundai.h). Tracked for visibility only: openpilot sends no CLU11 in this mode.
     cruise_engaged_prev = cruise_engaged;
   } else {
   }
 }
 
+// Gas interceptor: called on every RX message (hyundai_rx_hook), so a brake/gas press is caught even when it falls
+// between two CLU11 samples. Brake or gas during a pause/resume press (or its release debounce) cancels that resume,
+// and brake during a SET/RES press makes that press unable to engage.
+static void hyundai_gas_interceptor_pedal_check(void) {
+  if (brake_pressed || gas_pressed) {
+    hyundai_pause_armed = false;
+  }
+  bool setres_active = (cruise_button_prev == HYUNDAI_BTN_SET) || (cruise_button_prev == HYUNDAI_BTN_RESUME);
+  if (setres_active && brake_pressed) {
+    hyundai_setres_brake_seen = true;
+  }
+}
+
+// pause/resume button state machine, gas interceptor only. Must run BEFORE the CANCEL-held clear below: a new press
+// samples whether longitudinal was engaged at the moment the press began.
+static void hyundai_gas_interceptor_pause_button_check(const int cruise_button) {
+  bool pedal_pressed = brake_pressed || gas_pressed;
+  if (cruise_button == HYUNDAI_BTN_CANCEL) {
+    if (hyundai_pause_released_cnt >= HYUNDAI_PAUSE_RELEASE_SAMPLES) {
+      // new press (not a bounce of the previous one): resume press only if disengaged with no pedal pressed
+      hyundai_pause_armed = !controls_allowed && !pedal_pressed && !hyundai_factory_main_on;
+    }
+    hyundai_pause_released_cnt = 0U;
+  } else if (cruise_button != HYUNDAI_BTN_NONE) {
+    // rolled onto another cruise button: the pause press is abandoned (that button follows its own rules)
+    hyundai_pause_armed = false;
+    hyundai_pause_released_cnt = HYUNDAI_PAUSE_RELEASE_SAMPLES;
+  } else if (hyundai_pause_released_cnt < HYUNDAI_PAUSE_RELEASE_SAMPLES) {
+    hyundai_pause_released_cnt += 1U;
+    if (hyundai_pause_armed && !pedal_pressed && !hyundai_factory_main_on &&
+        (hyundai_pause_released_cnt == HYUNDAI_PAUSE_RELEASE_SAMPLES)) {
+      controls_allowed = true;
+      hyundai_pause_armed = false;
+    }
+  } else {
+  }
+  // brake or gas at any time during the press or its release debounce cancels the resume
+  if (pedal_pressed) {
+    hyundai_pause_armed = false;
+  }
+}
+
 void hyundai_common_cruise_buttons_check(const int cruise_button, const bool main_button) {
   if ((cruise_button == HYUNDAI_BTN_RESUME) || (cruise_button == HYUNDAI_BTN_SET) || (cruise_button == HYUNDAI_BTN_CANCEL) || main_button) {
     hyundai_last_button_interaction = 0U;
@@ -176,10 +239,29 @@ void hyundai_common_cruise_buttons_check(const int cruise_button, const bool mai
   }
 
   if (hyundai_longitudinal || hyundai_gas_interceptor) {
+    if (hyundai_gas_interceptor) {
+      hyundai_gas_interceptor_pause_button_check(cruise_button);
+    }
+
     // enter controls on falling edge of resume or set
+    // (gas interceptor: never while the factory cruise MAIN is armed, see hyundai_factory_main_on)
     bool set = (cruise_button != HYUNDAI_BTN_SET) && (cruise_button_prev == HYUNDAI_BTN_SET);
     bool res = (cruise_button != HYUNDAI_BTN_RESUME) && (cruise_button_prev == HYUNDAI_BTN_RESUME);
-    if (set || res) {
+    bool setres_blocked = false;
+    if (hyundai_gas_interceptor) {
+      // a SET/RES press only engages if the brake was released for the WHOLE press (a press held across the brake
+      // release, or released while braking at standstill, does not count) and the factory cruise MAIN is off
+      bool setres_held = (cruise_button == HYUNDAI_BTN_SET) || (cruise_button == HYUNDAI_BTN_RESUME);
+      bool setres_prev = (cruise_button_prev == HYUNDAI_BTN_SET) || (cruise_button_prev == HYUNDAI_BTN_RESUME);
+      if (setres_held && !setres_prev) {
+        hyundai_setres_brake_seen = false;  // new press
+      }
+      if ((setres_held || setres_prev) && brake_pressed) {
+        hyundai_setres_brake_seen = true;
+      }
+      setres_blocked = hyundai_factory_main_on || hyundai_setres_brake_seen;
+    }
+    if ((set || res) && !setres_blocked) {
       controls_allowed = true;
     }
 
