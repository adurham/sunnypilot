+  def test_latch_inert_on_positive_deliberate_ask_and_disengage(self):
+    vs = self.SET_KPH * CV.KPH_TO_MS
+    CI = self._ci()
+    self._run(CI, [(0.0, vs + 1.0, self.SET_KPH)] * 20)
